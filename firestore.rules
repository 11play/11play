    ===================================================== */

    function validReferralKeysV3(
      data
    ) {
      return data.keys().hasOnly([
        'referralId',
        'referrerUid',
        'referredUid',
        'referralCode',

        'referredProfile',

        'googleConnected',
        'mobileAdded',
        'deviceAdded',

        'activeDays',
        'requiredActiveDays',
        'requiredDailySeconds',
        'activityPolicyVersion',
        'activityCompleted',

        'eligible',
        'status',

        'rewardAmount',
        'rewardGranted',
        'rewardGrantedAt',

        'createdAt',
        'capturedAt',
        'qualifiedAt',
        'reviewedAt',
        'reviewedBy',
        'approvedAt',
        'rejectedAt',
        'rewardedAt',

        'adminNote',
        'updatedAt',
        'schemaVersion'
      ]);
    }

    function validReferredProfileSnapshot(
      data,
      uid,
      mobile
    ) {
      return data is map &&

        data.keys().hasOnly([
          'uid',
          'name',
          'displayName',
          'email',
          'photoURL',
          'mobileNumber'
        ]) &&

        data.get(
          'uid',
          ''
        ) == uid &&

        data.get(
          'name',
          ''
        ) is string &&

        data.get(
          'displayName',
          ''
        ) is string &&

        data.get(
          'email',
          ''
        ) is string &&

        data.get(
          'email',
          ''
        ).lower() ==
          currentEmail() &&

        data.get(
          'photoURL',
          ''
        ) is string &&

        data.get(
          'mobileNumber',
          ''
        ) == mobile;
    }

    function validCaptureStats(
      referrerUid
