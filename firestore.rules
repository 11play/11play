    /* =====================================================
       UNIQUE QUALIFICATION CHECKS
    ===================================================== */

    function mobileReservationBelongsTo(
      uid,
      mobile
    ) {
      let reservation =
        get(
          mobilePath(
            mobile
          )
        );

      return isValidBangladeshMobile(
          mobile
        ) &&

        reservation != null &&

        reservation.data.get(
          'uid',
          ''
        ) ==
          uid &&

        reservation.data.get(
          'userId',
          ''
        ) ==
          uid &&

        reservation.data.get(
          'mobile',
          ''
        ) ==
          mobile;
    }

    function deviceReservationBelongsTo(
      uid,
      deviceId
    ) {
      let reservation =
        get(
          devicePath(
            deviceId
          )
        );

      return isValidDeviceId(
          deviceId
        ) &&

        reservation != null &&

        reservation.data.get(
          'uid',
          ''
        ) ==
          uid &&

        reservation.data.get(
          'userId',
          ''
        ) ==
          uid &&

        reservation.data.get(
          'deviceId',
          ''
        ) ==
          deviceId;
    }

    function referralProjectionIsCurrent(
      after
    ) {
      let profileAfter =
        getAfter(
          profilePath(
            request.auth.uid
          )
        );

      let activityAfter =
        getAfter(
          activityPath(
            request.auth.uid
          )
        );

      let mobile =
        profileAfter == null
          ? ''
          : profileAfter.data.get(
              'mobileNumber',
              ''
            );

      let deviceId =
        profileAfter == null
          ? ''
          : profileAfter.data.get(
              'deviceId',
              ''
            );

      let days =
        activityAfter == null
          ? 0
          : activityAfter.data.get(
              'activeDays',
              0
            );

      let completed =
        activityAfter != null &&
        activityAfter.data.get(
          'completed',
          false
        ) == true;

      let mobileReady =
        profileAfter != null &&
        mobileReservationBelongsTo(
          request.auth.uid,
          mobile
        );

      let deviceReady =
        profileAfter != null &&
        deviceReservationBelongsTo(
          request.auth.uid,
          deviceId
        );

      return profileAfter != null &&

        profileAfter.data.get(
          'status',
          'active'
        ) == 'active' &&

        profileAfter.data.get(
          'googleConnected',
          false
        ) == true &&

        profileAfter.data.get(
          'isGoogleConnected',
          false
        ) == true &&

        activityAfter != null &&

        activityAfter.data.get(
          'schemaVersion',
          0
        ) == 3 &&

        activityAfter.data.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        activityAfter.data.get(
          'requiredDailySeconds',
          0
        ) == 7200 &&

        activityAfter.data.get(
          'requiredActiveDays',
          0
        ) == 7 &&

        activityAfter.data.get(
          'completed',
          false
        ) ==
          (
            days == 7
          ) &&

        after.get(
          'googleConnected',
          false
        ) == true &&

        after.get(
          'mobileAdded',
          false
        ) ==
          mobileReady &&

        after.get(
          'deviceAdded',
          false
        ) ==
          deviceReady &&

        after.get(
          'activeDays',
          -1
        ) ==
          days &&

        after.get(
          'requiredActiveDays',
          0
        ) == 7 &&

        after.get(
          'requiredDailySeconds',
          0
        ) == 7200 &&

        after.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        after.get(
          'activityCompleted',
          false
        ) ==
          completed &&

        after.get(
          'eligible',
          false
        ) ==
          (
            mobileReady &&
            deviceReady &&
            completed
          ) &&

        validReferredProfileSnapshot(
          after.get(
            'referredProfile',
            {}
          ),
          request.auth.uid,
          mobile
        );
    }

    function validQualificationStats(
      referrerUid
    ) {
      let beforeStats =
        get(
          statsPath(
            referrerUid
          )
        );

      let afterStats =
        getAfter(
          statsPath(
            referrerUid
          )
        );

      return beforeStats != null &&

        afterStats != null &&

        afterStats.data.get(
          'uid',
          ''
        ) ==
          referrerUid &&

        afterStats.data.get(
          'total',
          -1
        ) ==
          beforeStats.data.get(
            'total',
            0
          ) &&

        afterStats.data.get(
          'pending',
          -1
        ) ==
          (
            beforeStats.data.get(
              'pending',
              0
            ) > 0

              ? beforeStats.data.get(
                  'pending',
                  0
                ) - 1

              : 0
          ) &&

        afterStats.data.get(
          'qualified',
          -1
        ) ==
          beforeStats.data.get(
            'qualified',
            0
          ) + 1 &&

        afterStats.data.get(
          'approved',
          -1
        ) ==
          beforeStats.data.get(
            'approved',
            0
          ) &&

        afterStats.data.get(
          'rejected',
          -1
        ) ==
          beforeStats.data.get(
            'rejected',
            0
          ) &&

        afterStats.data.get(
          'rewarded',
          -1
        ) ==
          beforeStats.data.get(
            'rewarded',
            0
          ) &&

        afterStats.data.get(
          'totalReward',
          -1
        ) ==
          beforeStats.data.get(
            'totalReward',
            0
          );
    }

