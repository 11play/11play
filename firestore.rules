      let afterStats =
        getAfter(
          statsPath(
            referrerUid
          )
        );

      return beforeStats != null &&

        afterStats != null &&

        afterStats.data.get(
          'uid',
          ''
        ) ==
          referrerUid &&

        afterStats.data.get(
          'total',
          -1
        ) ==
          beforeStats.data.get(
            'total',
            0
          ) + 1 &&

        afterStats.data.get(
          'pending',
          -1
        ) ==
          beforeStats.data.get(
            'pending',
            0
          ) + 1 &&

        afterStats.data.get(
          'qualified',
          -1
        ) ==
          beforeStats.data.get(
            'qualified',
            0
          ) &&

        afterStats.data.get(
          'approved',
          -1
        ) ==
          beforeStats.data.get(
            'approved',
            0
          ) &&

        afterStats.data.get(
          'rejected',
          -1
        ) ==
          beforeStats.data.get(
            'rejected',
            0
          ) &&

        afterStats.data.get(
          'rewarded',
          -1
        ) ==
          beforeStats.data.get(
            'rewarded',
            0
          ) &&

        afterStats.data.get(
          'totalReward',
          -1
        ) ==
          beforeStats.data.get(
            'totalReward',
            0
          );
    }

    function validReferralCreate(
      referralId
    ) {
      let data =
        request.resource.data;

      let codeDoc =
        get(
          referralCodePath(
            data.get(
              'referralCode',
              ''
            )
          )
        );

      let profileAfter =
        getAfter(
          profilePath(
            request.auth.uid
          )
        );

      let activityAfter =
        getAfter(
          activityPath(
            request.auth.uid
          )
        );

      let referrerProfile =
        get(
          profilePath(
            data.get(
              'referrerUid',
              ''
            )
          )
        );

      return isVerifiedGoogle() &&

        referralId ==
          request.auth.uid &&

        validReferralKeysV3(
          data
        ) &&

        data.get(
          'referralId',
          ''
        ) ==
          referralId &&

        data.get(
          'referredUid',
          ''
        ) ==
          request.auth.uid &&

        data.get(
          'referrerUid',
          ''
        ) is string &&

        data.get(
          'referrerUid',
          ''
        ) != '' &&

        data.get(
          'referrerUid',
          ''
        ) !=
          request.auth.uid &&

        isValidReferralCode(
          data.get(
            'referralCode',
            ''
          )
        ) &&

        codeDoc != null &&

        codeDoc.data.get(
          'uid',
          ''
        ) ==
          data.get(
            'referrerUid',
            ''
          ) &&

        codeDoc.data.get(
          'active',
          false
        ) == true &&

        referrerProfile != null &&

        referrerProfile.data.get(
          'status',
          'active'
        ) == 'active' &&

        profileAfter != null &&

        profileAfter.data.get(
          'referredByUid',
          ''
        ) ==
          data.get(
            'referrerUid',
            ''
          ) &&

        profileAfter.data.get(
          'referredByCode',
          ''
        ) ==
          data.get(
            'referralCode',
            ''
          ) &&

        profileAfter.data.get(
          'referralCode',
          ''
        ) !=
          data.get(
            'referralCode',
            ''
          ) &&

        activityAfter != null &&

        activityAfter.data.get(
          'activeDays',
          -1
        ) == 0 &&

        activityAfter.data.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        validReferredProfileSnapshot(
          data.get(
            'referredProfile',
            {}
          ),
          request.auth.uid,
          ''
        ) &&

        data.get(
          'googleConnected',
          false
        ) == true &&

        data.get(
          'mobileAdded',
          false
        ) == false &&

        data.get(
          'deviceAdded',
          false
        ) == false &&

        data.get(
          'activeDays',
          -1
        ) == 0 &&

        data.get(
          'requiredActiveDays',
          0
        ) == 7 &&

        data.get(
          'requiredDailySeconds',
          0
        ) == 7200 &&

        data.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        data.get(
          'activityCompleted',
          false
        ) == false &&

        data.get(
          'eligible',
          false
        ) == false &&

        data.get(
          'status',
          ''
        ) == 'pending' &&

        data.get(
          'rewardAmount',
          0
        ) == 1000 &&

        data.get(
          'rewardGranted',
          false
        ) == false &&

        data.get(
          'rewardGrantedAt',
          null
        ) == null &&

        data.get(
          'qualifiedAt',
          null
        ) == null &&

        data.get(
          'reviewedAt',
          null
        ) == null &&

        data.get(
          'reviewedBy',
          ''
        ) == '' &&

        data.get(
          'approvedAt',
          null
        ) == null &&

        data.get(
          'rejectedAt',
          null
        ) == null &&

        data.get(
          'rewardedAt',
          null
        ) == null &&

        data.get(
          'adminNote',
          ''
        ) == '' &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        data.get(
          'capturedAt',
          null
        ) ==
          data.get(
            'createdAt',
            null
          ) &&

        data.get(
          'updatedAt',
          null
        ) ==
          data.get(
            'createdAt',
            null
          ) &&

        data.get(
          'schemaVersion',
          0
        ) == 3 &&

        validCaptureStats(
          data.get(
            'referrerUid',
            ''
          )
        );
