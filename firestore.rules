    function validReferralUpdateByReferredUser(
      referralId
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      let qualifiesNow =
        before.get(
          'status',
          'pending'
        ) == 'pending' &&

        after.get(
          'eligible',
          false
        ) == true;

      return isVerifiedGoogle() &&

        referralId ==
          request.auth.uid &&

        before.get(
          'referredUid',
          ''
        ) ==
          request.auth.uid &&

        before.get(
          'status',
          'pending'
        ) == 'pending' &&

        validReferralKeysV3(
          after
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'referredProfile',
          'googleConnected',
          'mobileAdded',
          'deviceAdded',
          'activeDays',
          'requiredActiveDays',
          'requiredDailySeconds',
          'activityPolicyVersion',
          'activityCompleted',
          'eligible',
          'status',
          'qualifiedAt',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.diff(
          before
        ).affectedKeys().hasAny([
          'referredProfile',
          'mobileAdded',
          'deviceAdded',
          'activeDays',
          'requiredDailySeconds',
          'activityPolicyVersion',
          'activityCompleted',
          'eligible',
          'status',
          'qualifiedAt'
        ]) &&

        after.get(
          'referralId',
          ''
        ) ==
          before.get(
            'referralId',
            ''
          ) &&

        after.get(
          'referrerUid',
          ''
        ) ==
          before.get(
            'referrerUid',
            ''
          ) &&

        after.get(
          'referredUid',
          ''
        ) ==
          before.get(
            'referredUid',
            ''
          ) &&

        after.get(
          'referralCode',
          ''
        ) ==
          before.get(
            'referralCode',
            ''
          ) &&

        after.get(
          'rewardAmount',
          0
        ) ==
          before.get(
            'rewardAmount',
            1000
          ) &&

        after.get(
          'rewardGranted',
          false
        ) ==
          before.get(
            'rewardGranted',
            false
          ) &&

        referralProjectionIsCurrent(
          after
        ) &&

        (
          (
            qualifiesNow &&

            after.get(
              'status',
              ''
            ) == 'qualified' &&

            isRequestTime(
              after.get(
                'qualifiedAt',
                null
              )
            ) &&

            validQualificationStats(
              before.get(
                'referrerUid',
                ''
              )
            )
          ) || (
            !qualifiesNow &&

            after.get(
              'status',
              ''
            ) == 'pending' &&

            after.get(
              'qualifiedAt',
              null
            ) ==
              before.get(
                'qualifiedAt',
                null
              )
          )
        ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function validReferralPolicyResetByReferredUser(
      referralId
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      return isVerifiedGoogle() &&

        referralId ==
          request.auth.uid &&

        before.get(
          'referredUid',
          ''
        ) ==
          request.auth.uid &&

        before.get(
          'status',
          ''
        ) == 'qualified' &&

        before.get(
          'rewardGranted',
          false
        ) == false &&

        validReferralKeysV3(
          after
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'referredProfile',
          'googleConnected',
          'mobileAdded',
          'deviceAdded',
          'activeDays',
          'requiredActiveDays',
          'requiredDailySeconds',
          'activityPolicyVersion',
          'activityCompleted',
          'eligible',
          'status',
          'qualifiedAt',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'referralId',
          ''
        ) ==
          before.get(
            'referralId',
            ''
          ) &&

        after.get(
          'referrerUid',
          ''
        ) ==
          before.get(
            'referrerUid',
            ''
          ) &&

        after.get(
          'referredUid',
          ''
        ) ==
          before.get(
            'referredUid',
            ''
          ) &&

        after.get(
          'referralCode',
          ''
        ) ==
          before.get(
            'referralCode',
            ''
          ) &&

        after.get(
          'rewardAmount',
          0
        ) ==
          before.get(
            'rewardAmount',
            1000
          ) &&

        after.get(
          'rewardGranted',
          false
        ) == false &&

        referralProjectionIsCurrent(
          after
        ) &&

        after.get(
          'eligible',
          false
        ) == false &&

        after.get(
          'status',
          ''
        ) == 'pending' &&

        after.get(
          'qualifiedAt',
          null
        ) == null &&

        validPolicyResetStats(
          before.get(
            'referrerUid',
            ''
          )
        ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function validReferralMigrationByReferredUser(
      referralId
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      return isVerifiedGoogle() &&

        referralId ==
          request.auth.uid &&

        before.get(
          'referredUid',
          ''
        ) ==
          request.auth.uid &&

        before.get(
          'schemaVersion',
          0
        ) == 2 &&

        validReferralKeysV3(
          after
        ) &&

        after.get(
          'referralId',
          referralId
        ) ==
          referralId &&

        after.get(
          'referrerUid',
          ''
        ) ==
          before.get(
            'referrerUid',
            ''
          ) &&

        after.get(
          'referredUid',
          ''
        ) ==
          before.get(
            'referredUid',
            ''
          ) &&

        after.get(
          'referralCode',
          ''
        ) ==
          before.get(
            'referralCode',
            ''
          ) &&

        after.get(
          'rewardAmount',
          0
        ) ==
          before.get(
            'rewardAmount',
            1000
          ) &&

        after.get(
          'rewardGranted',
          false
        ) ==
          before.get(
            'rewardGranted',
            false
          ) &&

        after.get(
          'rewardGrantedAt',
          null
        ) ==
          before.get(
            'rewardGrantedAt',
            null
          ) &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        after.get(
          'capturedAt',
          null
        ) ==
          before.get(
            'capturedAt',
            before.get(
              'createdAt',
              null
            )
          ) &&

        after.get(
          'reviewedAt',
          null
        ) ==
          before.get(
            'reviewedAt',
            null
          ) &&

        after.get(
          'reviewedBy',
          ''
        ) ==
          before.get(
            'reviewedBy',
            ''
          ) &&

        after.get(
          'approvedAt',
          null
        ) ==
          before.get(
            'approvedAt',
            null
          ) &&

        after.get(
          'rejectedAt',
          null
        ) ==
          before.get(
            'rejectedAt',
            null
          ) &&

        after.get(
          'rewardedAt',
          null
        ) ==
          before.get(
            'rewardedAt',
            null
          ) &&

        after.get(
          'adminNote',
          ''
        ) ==
          before.get(
            'adminNote',
            ''
          ) &&

        isValidReferralStatus(
          after.get(
            'status',
            ''
          )
        ) &&

        after.get(
          'status',
          ''
        ) ==
          (
            before.get(
              'status',
              'pending'
            ) == 'captured'

              ? 'pending'

              : before.get(
                  'status',
                  'pending'
                )
          ) &&

        after.get(
          'qualifiedAt',
          null
        ) ==
          (
            after.get(
              'status',
              ''
            ) == 'pending'

              ? null

              : before.get(
                  'qualifiedAt',
                  null
                )
          ) &&

        referralProjectionIsCurrent(
          after
        ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    /* =====================================================
       REFERRAL STATS
    ===================================================== */

    function validStatsKeys(
      data
    ) {
      return data.keys().hasOnly([
        'uid',
        'total',
        'pending',
        'qualified',
        'approved',
        'rejected',
        'rewarded',
        'totalReward',
        'createdAt',
        'updatedAt',
        'schemaVersion'
      ]);
    }

    function validInitialStats(
      uid,
      data
    ) {
      return data.get(
          'uid',
          ''
        ) == uid &&

        validStatsKeys(
          data
        ) &&

        data.get(
          'total',
          -1
        ) == 0 &&

        data.get(
          'pending',
          -1
        ) == 0 &&

        data.get(
          'qualified',
          -1
        ) == 0 &&

        data.get(
          'approved',
          -1
        ) == 0 &&

        data.get(
          'rejected',
          -1
        ) == 0 &&

        data.get(
          'rewarded',
          -1
        ) == 0 &&

        data.get(
          'totalReward',
          -1
        ) == 0 &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'updatedAt',
            null
          )
        ) &&

        data.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function statsFinalCountersUnchanged(
      before,
      after
    ) {
      return after.get(
          'approved',
          0
        ) ==
          before.get(
            'approved',
            0
          ) &&

        after.get(
          'rejected',
          0
        ) ==
          before.get(
            'rejected',
            0
          ) &&

        after.get(
          'rewarded',
          0
        ) ==
          before.get(
            'rewarded',
            0
          ) &&

        after.get(
          'totalReward',
          0
        ) ==
          before.get(
            'totalReward',
            0
          );
    }

    function validRelatedStatsUpdate(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      let referralBefore =
        get(
          referralPath(
            request.auth.uid
          )
        );

      let referralAfter =
        getAfter(
          referralPath(
            request.auth.uid
          )
        );

      let capture =
        referralBefore == null &&
        referralAfter != null;

      let qualify =
        referralBefore != null &&

        referralAfter != null &&

        referralBefore.data.get(
          'status',
          'pending'
        ) == 'pending' &&

        referralAfter.data.get(
          'status',
          ''
        ) == 'qualified';

      let policyReset =
        referralBefore != null &&

        referralAfter != null &&

        referralBefore.data.get(
          'status',
          ''
        ) == 'qualified' &&

        referralAfter.data.get(
          'status',
          ''
        ) == 'pending';

      return isVerifiedGoogle() &&

        request.auth.uid != uid &&

        validStatsKeys(
          after
        ) &&

        after.get(
          'uid',
          ''
        ) == uid &&

        referralAfter != null &&

        referralAfter.data.get(
          'referrerUid',
          ''
        ) == uid &&

        referralAfter.data.get(
          'referredUid',
          ''
        ) ==
          request.auth.uid &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'total',
          'pending',
          'qualified',
          'updatedAt',
          'schemaVersion'
        ]) &&

        statsFinalCountersUnchanged(
          before,
          after
        ) &&

        (
          (
            capture &&

            referralAfter.data.get(
              'status',
              ''
            ) == 'pending' &&

            after.get(
              'total',
              -1
            ) ==
              before.get(
                'total',
                0
              ) + 1 &&

            after.get(
              'pending',
              -1
            ) ==
              before.get(
                'pending',
                0
              ) + 1 &&

            after.get(
              'qualified',
              -1
            ) ==
              before.get(
                'qualified',
                0
              )
          ) || (
            qualify &&

            after.get(
              'total',
              -1
            ) ==
              before.get(
                'total',
                0
              ) &&

            after.get(
              'pending',
              -1
            ) ==
              (
                before.get(
                  'pending',
                  0
                ) > 0

                  ? before.get(
                      'pending',
                      0
                    ) - 1

                  : 0
              ) &&

            after.get(
              'qualified',
              -1
            ) ==
              before.get(
                'qualified',
                0
              ) + 1
          ) || (
            policyReset &&

            after.get(
              'total',
              -1
            ) ==
              before.get(
                'total',
                0
              ) &&

            after.get(
              'pending',
              -1
            ) ==
              before.get(
                'pending',
                0
              ) + 1 &&

            after.get(
              'qualified',
              -1
            ) ==
              (
                before.get(
                  'qualified',
                  0
                ) > 0

                  ? before.get(
                      'qualified',
                      0
                    ) - 1

                  : 0
              )
          )
        ) &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function validStatsMigration(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      return isOwner(uid) &&

        before.get(
          'schemaVersion',
          0
        ) == 2 &&

        validStatsKeys(
          after
        ) &&

        after.get(
          'uid',
          ''
        ) == uid &&

        after.get(
          'total',
          0
        ) ==
          before.get(
            'total',
            0
          ) &&

        after.get(
          'pending',
          0
        ) ==
          before.get(
            'pending',
            0
          ) &&

        after.get(
          'qualified',
          0
        ) ==
          before.get(
            'qualified',
            0
          ) &&

        after.get(
          'approved',
          0
        ) ==
          before.get(
            'approved',
            0
          ) &&

        after.get(
          'rejected',
          0
        ) ==
          before.get(
            'rejected',
            0
          ) &&

        after.get(
          'rewarded',
          0
        ) ==
          before.get(
            'rewarded',
            0
          ) &&

        after.get(
          'totalReward',
          0
        ) ==
          before.get(
            'totalReward',
            0
          ) &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    /* =====================================================
       ACTIVITY — POLICY VERSION 2
    ===================================================== */

    function validActivityKeysV3(
      data
    ) {
      return data.keys().hasOnly([
        'uid',
        'userId',
        'deviceId',

        'activeDays',
        'requiredActiveDays',

        'currentDaySeconds',
        'requiredDailySeconds',
        'currentDayStartedAt',
        'currentDayCompleted',
        'lastCheckpointAt',

        'completed',
        'lastActiveAt',
        'completedAt',

        'activityPolicyVersion',

        'createdAt',
        'updatedAt',
        'schemaVersion'
      ]);
    }

    function validInitialActivity(
      uid,
      data
    ) {
      return validActivityKeysV3(
          data
        ) &&

        data.get(
          'uid',
          ''
        ) == uid &&

        data.get(
          'userId',
          ''
        ) == uid &&

        data.get(
          'deviceId',
          ''
        ) == '' &&

        data.get(
          'activeDays',
          -1
        ) == 0 &&

        data.get(
          'requiredActiveDays',
          0
        ) == 7 &&

        data.get(
          'currentDaySeconds',
          -1
        ) == 0 &&

        data.get(
          'requiredDailySeconds',
          0
        ) == 7200 &&

        data.get(
          'currentDayStartedAt',
          null
        ) == null &&

        data.get(
          'currentDayCompleted',
          false
        ) == false &&

        data.get(
          'lastCheckpointAt',
          null
        ) == null &&

        data.get(
          'completed',
          false
        ) == false &&

        data.get(
          'lastActiveAt',
          null
        ) == null &&

        data.get(
          'completedAt',
          null
        ) == null &&

        data.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'updatedAt',
            null
          )
        ) &&

        data.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function validActivityProfile(
      uid,
      profile
    ) {
      return profile != null &&

        profile.data.get(
          'schemaVersion',
          0
        ) == 3 &&

        profile.data.get(
          'status',
          'active'
        ) == 'active' &&

        profile.data.get(
          'googleConnected',
          false
        ) == true &&

        profile.data.get(
          'isGoogleConnected',
          false
        ) == true &&

        isValidBangladeshMobile(
          profile.data.get(
            'mobileNumber',
            ''
          )
        ) &&

        profile.data.get(
          'mobileAdded',
          false
        ) == true &&

        profile.data.get(
          'mobileLocked',
          false
        ) == true &&

        isValidDeviceId(
          profile.data.get(
            'deviceId',
            ''
          )
        ) &&

        profile.data.get(
          'deviceAdded',
          false
        ) == true &&

        profile.data.get(
          'deviceLocked',
          false
        ) == true;
    }

    function isNewBangladeshActivityDay(
      before
    ) {
      let dayStart =
        before.get(
          'currentDayStartedAt',
          null
        );

      return dayStart == null || (
        dayStart is timestamp &&

        bangladeshDate(
          dayStart
        ) !=
          bangladeshDate(
            request.time
          )
      );
    }

    function isSameBangladeshActivityDay(
      before
    ) {
      let dayStart =
        before.get(
          'currentDayStartedAt',
          null
        );

      return dayStart is timestamp &&

        bangladeshDate(
          dayStart
        ) ==
          bangladeshDate(
            request.time
          );
    }

    /* =====================================================
       START NEW BD DAY
    ===================================================== */

    function validOwnerActivityStart(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      let profile =
        get(
          profilePath(uid)
        );

      return isOwner(uid) &&

        validActivityProfile(
          uid,
          profile
        ) &&

        before.get(
          'schemaVersion',
          0
        ) == 3 &&

        before.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        before.get(
          'completed',
          false
        ) == false &&

        before.get(
          'activeDays',
          0
        ) < 7 &&

        isNewBangladeshActivityDay(
          before
        ) &&

        validActivityKeysV3(
          after
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'deviceId',
          'currentDaySeconds',
          'currentDayStartedAt',
          'currentDayCompleted',
          'lastCheckpointAt',
          'lastActiveAt',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'uid',
          ''
        ) == uid &&

        after.get(
          'userId',
          ''
        ) == uid &&

        after.get(
          'deviceId',
          ''
        ) ==
          profile.data.get(
            'deviceId',
            ''
          ) &&

        after.get(
          'activeDays',
          -1
        ) ==
          before.get(
            'activeDays',
            0
          ) &&

        after.get(
          'requiredActiveDays',
          0
        ) == 7 &&

        after.get(
          'currentDaySeconds',
          -1
        ) == 0 &&

        after.get(
          'requiredDailySeconds',
          0
        ) == 7200 &&

        isRequestTime(
          after.get(
            'currentDayStartedAt',
            null
          )
        ) &&

        after.get(
          'currentDayCompleted',
          false
        ) == false &&

        isRequestTime(
          after.get(
            'lastCheckpointAt',
            null
          )
        ) &&

        after.get(
          'completed',
          false
        ) == false &&

        isRequestTime(
          after.get(
            'lastActiveAt',
            null
          )
        ) &&

        after.get(
          'completedAt',
          null
        ) ==
          before.get(
            'completedAt',
            null
          ) &&

        after.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    /* =====================================================
       RESUME AFTER INACTIVE GAP
       Gap over 20 minutes earns zero activity.
    ===================================================== */

    function validOwnerActivityResume(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      let profile =
        get(
          profilePath(uid)
        );

      let lastCheckpoint =
        before.get(
          'lastCheckpointAt',
          null
        );

      return isOwner(uid) &&

        validActivityProfile(
          uid,
          profile
        ) &&

        before.get(
          'schemaVersion',
          0
        ) == 3 &&

        before.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        before.get(
          'completed',
          false
        ) == false &&

        before.get(
          'activeDays',
          0
        ) < 7 &&

        before.get(
          'currentDayCompleted',
          false
        ) == false &&

        isSameBangladeshActivityDay(
          before
        ) &&

        lastCheckpoint is timestamp &&

        request.time >
          lastCheckpoint +
          duration.value(
            20,
            'm'
          ) &&

        validActivityKeysV3(
          after
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'lastCheckpointAt',
          'lastActiveAt',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'uid',
          ''
        ) == uid &&

        after.get(
          'userId',
          ''
        ) == uid &&

        after.get(
          'deviceId',
          ''
        ) ==
          profile.data.get(
            'deviceId',
            ''
          ) &&

        after.get(
          'activeDays',
          -1
        ) ==
          before.get(
            'activeDays',
            0
          ) &&

        after.get(
          'requiredActiveDays',
          0
        ) == 7 &&

        after.get(
          'currentDaySeconds',
          -1
        ) ==
          before.get(
            'currentDaySeconds',
            0
          ) &&

        isValidDailyActivitySeconds(
          after.get(
            'currentDaySeconds',
            -1
          )
        ) &&

        after.get(
          'requiredDailySeconds',
          0
        ) == 7200 &&

        after.get(
          'currentDayStartedAt',
          null
        ) ==
          before.get(
            'currentDayStartedAt',
            null
          ) &&

        after.get(
          'currentDayCompleted',
          false
        ) == false &&

        isRequestTime(
          after.get(
            'lastCheckpointAt',
            null
          )
        ) &&

        after.get(
          'completed',
          false
        ) == false &&

        isRequestTime(
          after.get(
            'lastActiveAt',
            null
          )
        ) &&

        after.get(
          'completedAt',
          null
        ) ==
          before.get(
            'completedAt',
            null
          ) &&

        after.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    /* =====================================================
       15-MINUTE CHECKPOINT
    ===================================================== */

    function validOwnerActivityCheckpoint(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      let profile =
        get(
          profilePath(uid)
        );

      let lastCheckpoint =
        before.get(
          'lastCheckpointAt',
          null
        );

      let nextDailySeconds =
        before.get(
          'currentDaySeconds',
          0
        ) + 900;

      let completesDay =
        nextDailySeconds ==
        7200;

      let nextDays =
        before.get(
          'activeDays',
          0
        ) +
        (
          completesDay
            ? 1
            : 0
        );

      let completesAll =
        nextDays == 7;

      return isOwner(uid) &&

        validActivityProfile(
          uid,
          profile
        ) &&

        before.get(
          'schemaVersion',
          0
        ) == 3 &&

        before.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        before.get(
          'completed',
          false
        ) == false &&

        before.get(
          'activeDays',
          0
        ) < 7 &&

        before.get(
          'currentDayCompleted',
          false
        ) == false &&

        isSameBangladeshActivityDay(
          before
        ) &&

        lastCheckpoint is timestamp &&

        request.time >=
          lastCheckpoint +
          duration.value(
            15,
            'm'
          ) &&

        request.time <=
          lastCheckpoint +
          duration.value(
            20,
            'm'
          ) &&

        isValidDailyActivitySeconds(
          before.get(
            'currentDaySeconds',
            -1
          )
        ) &&

        before.get(
          'currentDaySeconds',
          0
        ) < 7200 &&

        validActivityKeysV3(
          after
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'activeDays',
          'currentDaySeconds',
          'currentDayCompleted',
          'lastCheckpointAt',
          'completed',
          'lastActiveAt',
          'completedAt',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'uid',
          ''
        ) == uid &&

        after.get(
          'userId',
          ''
        ) == uid &&

        after.get(
          'deviceId',
          ''
        ) ==
          profile.data.get(
            'deviceId',
            ''
          ) &&

        after.get(
          'activeDays',
          -1
        ) ==
          nextDays &&

        nextDays <= 7 &&

        after.get(
          'requiredActiveDays',
          0
        ) == 7 &&

        after.get(
          'currentDaySeconds',
          -1
        ) ==
          nextDailySeconds &&

        isValidDailyActivitySeconds(
          after.get(
            'currentDaySeconds',
            -1
          )
        ) &&

        after.get(
          'requiredDailySeconds',
          0
        ) == 7200 &&

        after.get(
          'currentDayStartedAt',
          null
        ) ==
          before.get(
            'currentDayStartedAt',
            null
          ) &&

        after.get(
          'currentDayCompleted',
          false
        ) ==
          completesDay &&

        isRequestTime(
          after.get(
            'lastCheckpointAt',
            null
          )
        ) &&

        after.get(
          'completed',
          false
        ) ==
          completesAll &&

        isRequestTime(
          after.get(
            'lastActiveAt',
            null
          )
        ) &&

        (
          (
            completesAll &&

            isRequestTime(
              after.get(
                'completedAt',
                null
              )
            )
          ) || (
            !completesAll &&

            after.get(
              'completedAt',
              null
            ) ==
              before.get(
                'completedAt',
                null
              )
          )
        ) &&

        after.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    /* =====================================================
       LEGACY ACTIVITY MIGRATION
    ===================================================== */

    function legacyReferralIsFinal(
      uid
    ) {
      let referral =
        get(
          referralPath(uid)
        );

      return referral != null &&

        referral.data.get(
          'status',
          ''
        ) in [
          'approved',
          'rewarded'
        ];
    }

    function validActivityMigration(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      let oldPolicy =
        before.get(
          'activityPolicyVersion',
          0
        ) != 2;

      let oldSchema =
        before.get(
          'schemaVersion',
          0
        );

      let previouslyCompleted =
        before.get(
          'completed',
          false
        ) == true ||

        before.get(
          'activeDays',
          0
        ) >= 7 ||

        before.get(
          'totalActiveSeconds',
          0
        ) >= 604800;

      let grandfatherCompleted =
        previouslyCompleted &&
        legacyReferralIsFinal(
          uid
        );

      return isOwner(uid) &&

        (
          oldSchema == 2 ||
          oldSchema == 3
        ) &&

        oldPolicy &&

        validActivityKeysV3(
          after
        ) &&

        after.get(
          'uid',
          ''
        ) == uid &&

        after.get(
          'userId',
          ''
        ) == uid &&

        after.get(
          'deviceId',
          ''
        ) == '' &&

        after.get(
          'activeDays',
          -1
        ) ==
          (
            grandfatherCompleted
              ? 7
              : 0
          ) &&

        after.get(
          'requiredActiveDays',
          0
        ) == 7 &&

        after.get(
          'currentDaySeconds',
          -1
        ) == 0 &&

        after.get(
          'requiredDailySeconds',
          0
        ) == 7200 &&

        after.get(
          'currentDayStartedAt',
          null
        ) == null &&

        after.get(
          'currentDayCompleted',
          false
        ) == false &&

        after.get(
          'lastCheckpointAt',
          null
        ) == null &&

        after.get(
          'completed',
          false
        ) ==
          grandfatherCompleted &&

        after.get(
          'lastActiveAt',
          null
        ) == null &&

        (
          (
            grandfatherCompleted &&

            (
              (
                before.get(
                  'completedAt',
                  null
                ) is timestamp &&

                after.get(
                  'completedAt',
                  null
                ) ==
                  before.get(
                    'completedAt',
                    null
                  )
              ) || (
                before.get(
                  'completedAt',
                  null
                ) == null &&

                isRequestTime(
                  after.get(
                    'completedAt',
                    null
                  )
                )
              )
            )
          ) || (
            !grandfatherCompleted &&

            after.get(
              'completedAt',
              null
            ) == null
          )
        ) &&

        after.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    /* =====================================================
       WALLET
    ===================================================== */

    function validWalletKeysV3(
      data
    ) {
      return data.keys().hasOnly([
        'uid',
        'userId',

        'availableBalance',
        'heldBalance',

        'totalEarned',
        'totalWithdrawn',

        'lastWithdrawalAmount',
        'lastWithdrawalAt',

        'revision',

        'lastOperationId',
        'lastOperationType',
        'lastOperationAt',

        'createdAt',
        'updatedAt',
        'schemaVersion'
      ]);
    }

    function validInitialWallet(
      uid,
      data
    ) {
      return validWalletKeysV3(
          data
        ) &&

        data.get(
          'uid',
          ''
        ) == uid &&

        data.get(
          'userId',
          ''
        ) == uid &&

        data.get(
          'availableBalance',
          -1
        ) == 0 &&

        data.get(
          'heldBalance',
          -1
        ) == 0 &&

        data.get(
          'totalEarned',
          -1
        ) == 0 &&

        data.get(
          'totalWithdrawn',
          -1
        ) == 0 &&

        data.get(
          'lastWithdrawalAmount',
          -1
        ) == 0 &&

        data.get(
          'lastWithdrawalAt',
          null
        ) == null &&

        data.get(
          'revision',
          -1
        ) == 0 &&

        data.get(
          'lastOperationId',
          ''
        ) == '' &&

        data.get(
          'lastOperationType',
          ''
        ) == '' &&

        data.get(
          'lastOperationAt',
          null
        ) == null &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'updatedAt',
            null
          )
        ) &&

        data.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function validOwnerWalletHold(
      uid,
      before,
      after
    ) {
      let transactionId =
        after.get(
          'lastOperationId',
          ''
        );

      let ledgerAfter =
        getAfter(
          walletTransactionPath(
            transactionId
          )
        );

      let withdrawalId =
        ledgerAfter == null
          ? ''
          : ledgerAfter.data.get(
              'referenceId',
              ''
            );

      let withdrawalAfter =
        withdrawalId == ''
          ? null
          : getAfter(
              withdrawalPath(
                withdrawalId
              )
            );

      let amount =
        before.get(
          'availableBalance',
          0
        ) -
        after.get(
          'availableBalance',
          0
        );

      return after.get(
          'lastOperationType',
          ''
        ) ==
          'withdraw_hold' &&

        transactionId ==
          'withdraw_hold_' +
          withdrawalId &&

        withdrawalId != '' &&

        isValidWithdrawalAmount(
          amount
        ) &&

        after.get(
          'heldBalance',
          -1
        ) ==
          before.get(
            'heldBalance',
            0
          ) +
          amount &&

        after.get(
          'totalEarned',
          0
        ) ==
          before.get(
            'totalEarned',
            0
          ) &&

        after.get(
          'totalWithdrawn',
          0
        ) ==
          before.get(
            'totalWithdrawn',
            0
          ) &&

        after.get(
          'lastWithdrawalAmount',
          0
        ) ==
          before.get(
            'lastWithdrawalAmount',
            0
          ) &&

        after.get(
          'lastWithdrawalAt',
          null
        ) ==
          before.get(
            'lastWithdrawalAt',
            null
          ) &&

        ledgerAfter != null &&

        ledgerAfter.data.get(
          'userId',
          ''
        ) == uid &&

        ledgerAfter.data.get(
          'type',
          ''
        ) ==
          'withdraw_hold' &&

        ledgerAfter.data.get(
          'amount',
          0
        ) ==
          amount &&

        withdrawalAfter != null &&

        withdrawalAfter.data.get(
          'userId',
          ''
        ) == uid &&

        withdrawalAfter.data.get(
          'status',
          ''
        ) ==
          'pending' &&

        withdrawalAfter.data.get(
          'amount',
          0
        ) ==
          amount;
    }

    function validOwnerWalletUpdate(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      return isOwner(uid) &&

        before.get(
          'schemaVersion',
          0
        ) == 3 &&

        validWalletKeysV3(
          after
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'availableBalance',
          'heldBalance',

          'revision',

          'lastOperationId',
          'lastOperationType',
          'lastOperationAt',

          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'uid',
          ''
        ) == uid &&

        after.get(
          'userId',
          ''
        ) == uid &&

        after.get(
          'availableBalance',
          -1
        ) is int &&

        after.get(
          'availableBalance',
          -1
        ) >= 0 &&

        after.get(
          'heldBalance',
          -1
        ) is int &&

        after.get(
          'heldBalance',
          -1
        ) >= 0 &&

        after.get(
          'revision',
          -1
        ) ==
          before.get(
            'revision',
            0
          ) + 1 &&

        isRequestTime(
          after.get(
            'lastOperationAt',
            null
          )
        ) &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        validOwnerWalletHold(
          uid,
          before,
          after
        ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function validWalletMigration(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      return isOwner(uid) &&

        before.get(
          'schemaVersion',
          0
        ) == 2 &&

        validWalletKeysV3(
          after
        ) &&

        after.get(
          'uid',
