rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================
       11PLAY — FIRESTORE SECURITY RULES
       Production / Firebase Spark / GitHub Pages

       Final referral qualification:
       - Verified Google account
       - Globally unique Bangladesh mobile
       - Unique Web Device binding
       - 7 different Bangladesh calendar days
       - Minimum 2 real hours eligible activity per day
       - Admin review before ৳1000 reward

       Activity:
       - 15-minute server-time checkpoints
       - 120 minutes required per eligible day
       - Maximum one eligible-day credit per BD date
       - Maximum seven eligible days
       - Browser/device clock is never authoritative

       Withdrawal:
       - User creates request only
       - User cannot cancel/edit/delete after submit
       - Admin only Approve / Reject

       Popular:
       - siteClicks publicly readable
       - Browser writes disabled
       - Values may be maintained manually from Firebase Console

       Permanent Admin:
       - casinobuzzbd@gmail.com
    ===================================================== */

    /* =====================================================
       COMMON HELPERS
    ===================================================== */

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedGoogle() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function currentEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return isVerifiedGoogle() &&
        currentEmail() == 'casinobuzzbd@gmail.com';
    }

    function isOwner(uid) {
      return isVerifiedGoogle() &&
        request.auth.uid == uid;
    }

    function isRequestTime(value) {
      return value is timestamp &&
        value == request.time;
    }

    function bangladeshDate(value) {
      return (
        value +
        duration.value(6, 'h')
      ).date();
    }

    function isValidReferralCode(value) {
      return value is string &&
        value.matches(
          '^[A-HJ-NP-Z2-9]{8}$'
        );
    }

    function isValidBangladeshMobile(value) {
      return value is string &&
        value.matches(
          '^[+]8801[3-9][0-9]{8}$'
        );
    }

    function isValidDeviceId(value) {
      return value is string &&
        value.matches(
          '^[a-f0-9]{64}$'
        );
    }

    function isValidProvider(value) {
      return value is string &&
        value in [
          'bkash',
          'nagad',
          'rocket'
        ];
    }

    function isValidWithdrawalAmount(value) {
      return value is int &&
        value >= 1000 &&
        value % 1000 == 0;
    }

    function isValidProfileStatus(value) {
      return value is string &&
        value in [
          'active',
          'suspended',
          'blocked'
        ];
    }

    function isValidReferralStatus(value) {
      return value is string &&
        value in [
          'pending',
          'qualified',
          'approved',
          'rewarded',
          'rejected'
        ];
    }

    function isValidDailyActivitySeconds(value) {
      return value is int &&
        value >= 0 &&
        value <= 7200 &&
        value % 900 == 0;
    }

    /* =====================================================
       PATH HELPERS
    ===================================================== */

    function profilePath(uid) {
      return /databases/$(database)/documents/profileUsers/$(uid);
    }

    function referralCodePath(code) {
      return /databases/$(database)/documents/profileReferralCodes/$(code);
    }

    function mobilePath(mobile) {
      return /databases/$(database)/documents/profileMobiles/$(mobile);
    }

    function devicePath(deviceId) {
      return /databases/$(database)/documents/profileDevices/$(deviceId);
    }

    function referralPath(referralId) {
      return /databases/$(database)/documents/profileReferrals/$(referralId);
    }

    function statsPath(uid) {
      return /databases/$(database)/documents/profileReferralStats/$(uid);
    }

    function activityPath(uid) {
      return /databases/$(database)/documents/profileActivity/$(uid);
    }

    function walletPath(uid) {
      return /databases/$(database)/documents/profileWallets/$(uid);
    }

    function walletTransactionPath(transactionId) {
      return /databases/$(database)/documents/profileWalletTransactions/$(transactionId);
    }

    function withdrawalPath(withdrawalId) {
      return /databases/$(database)/documents/profileWithdrawals/$(withdrawalId);
    }

    function rewardPath(rewardEventId) {
      return /databases/$(database)/documents/profileRewardEvents/$(rewardEventId);
    }

    function auditPath(auditId) {
      return /databases/$(database)/documents/profileAuditLogs/$(auditId);
    }

    function belongsToCurrentUser(data) {
      return isVerifiedGoogle() &&
        (
          data.get(
            'uid',
            ''
          ) == request.auth.uid ||
          data.get(
            'userId',
            ''
          ) == request.auth.uid
        );
    }

    function isReferralParticipant(data) {
      return isVerifiedGoogle() &&
        (
          data.get(
            'referrerUid',
            ''
          ) == request.auth.uid ||
          data.get(
            'referredUid',
            ''
          ) == request.auth.uid
        );
    }

    /* =====================================================
       PROFILE
    ===================================================== */

    function validProfileKeysV3(data) {
      return data.keys().hasOnly([
        'uid',
        'name',
        'displayName',
        'username',
        'email',
        'photo',
        'photoURL',
        'emailVerified',
        'providerIds',
        'googleConnected',
        'isGoogleConnected',
        'accountType',
        'isAdmin',
        'role',

        'mobileNumber',
        'mobileAdded',
        'mobileLocked',

        'deviceId',
        'deviceAdded',
        'deviceLocked',

        'referralCode',
        'referralLink',
        'referredByUid',
        'referredByCode',

        'registrationDate',
        'createdAt',
        'lastLogin',
        'updatedAt',

        'status',
        'statusChangedAt',
        'statusChangedBy',

        'schemaVersion'
      ]);
    }

    function validProfileIdentity(
      uid,
      data
    ) {
      let adminIdentity =
        currentEmail() ==
        'casinobuzzbd@gmail.com';

      return data.get(
          'uid',
          ''
        ) == uid &&

        data.get(
          'email',
          ''
        ) is string &&

        data.get(
          'email',
          ''
        ).lower() ==
          currentEmail() &&

        data.get(
          'emailVerified',
          false
        ) == true &&

        data.get(
          'providerIds',
          []
        ) is list &&

        data.get(
          'providerIds',
          []
        ).hasAny([
          'google.com'
        ]) &&

        data.get(
          'googleConnected',
          false
        ) == true &&

        data.get(
          'isGoogleConnected',
          false
        ) == true &&

        data.get(
          'accountType',
          ''
        ) == 'google' &&

        data.get(
          'isAdmin',
          false
        ) == adminIdentity &&

        data.get(
          'role',
          ''
        ) ==
          (
            adminIdentity
              ? 'admin'
              : 'user'
          );
    }

    function validProfileReferralBindingOnCreate(
      uid,
      data
    ) {
      let referrerUid =
        data.get(
          'referredByUid',
          ''
        );

      let referrerCode =
        data.get(
          'referredByCode',
          ''
        );

      let relationAfter =
        referrerUid == ''
          ? null
          : getAfter(
              referralPath(uid)
            );

      let codeDoc =
        referrerCode == ''
          ? null
          : get(
              referralCodePath(
                referrerCode
              )
            );

      return (
        referrerUid == '' &&
        referrerCode == ''
      ) || (
        referrerUid is string &&

        referrerUid != '' &&

        referrerUid != uid &&

        isValidReferralCode(
          referrerCode
        ) &&

        codeDoc != null &&

        codeDoc.data.get(
          'uid',
          ''
        ) == referrerUid &&

        codeDoc.data.get(
          'active',
          false
        ) == true &&

        relationAfter != null &&

        relationAfter.data.get(
          'referrerUid',
          ''
        ) == referrerUid &&

        relationAfter.data.get(
          'referredUid',
          ''
        ) == uid &&

        relationAfter.data.get(
          'referralCode',
          ''
        ) == referrerCode
      );
    }

    function validProfileReferralBindingAfterMigration(
      uid,
      data
    ) {
      let referrerUid =
        data.get(
          'referredByUid',
          ''
        );

      let referrerCode =
        data.get(
          'referredByCode',
          ''
        );

      let relationAfter =
        referrerUid == ''
          ? null
          : getAfter(
              referralPath(uid)
            );

      let codeDoc =
        referrerCode == ''
          ? null
          : get(
              referralCodePath(
                referrerCode
              )
            );

      return (
        referrerUid == '' &&
        referrerCode == ''
      ) || (
        referrerUid is string &&

        referrerUid != '' &&

        referrerUid != uid &&

        isValidReferralCode(
          referrerCode
        ) &&

        codeDoc != null &&

        codeDoc.data.get(
          'uid',
          ''
        ) == referrerUid &&

        codeDoc.data.get(
          'active',
          false
        ) == true &&

        relationAfter != null &&

        relationAfter.data.get(
          'referrerUid',
          ''
        ) == referrerUid &&

        relationAfter.data.get(
          'referredUid',
          ''
        ) == uid &&

        relationAfter.data.get(
          'referralCode',
          ''
        ) == referrerCode
      );
    }

    function validProfileBootstrapCompanions(
      uid,
      data
    ) {
      let codeAfter =
        getAfter(
          referralCodePath(
            data.get(
              'referralCode',
              ''
            )
          )
        );

      let statsAfter =
        getAfter(
          statsPath(uid)
        );

      let activityAfter =
        getAfter(
          activityPath(uid)
        );

      let walletAfter =
        getAfter(
          walletPath(uid)
        );

      return codeAfter != null &&

        codeAfter.data.get(
          'uid',
          ''
        ) == uid &&

        codeAfter.data.get(
          'referralCode',
          ''
        ) ==
          data.get(
            'referralCode',
            ''
          ) &&

        statsAfter != null &&

        statsAfter.data.get(
          'uid',
          ''
        ) == uid &&

        activityAfter != null &&

        activityAfter.data.get(
          'uid',
          ''
        ) == uid &&

        activityAfter.data.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        walletAfter != null &&

        walletAfter.data.get(
          'uid',
          ''
        ) == uid;
    }

    function validOwnerProfileCreate(
      uid
    ) {
      let data =
        request.resource.data;

      return isOwner(uid) &&

        validProfileKeysV3(
          data
        ) &&

        validProfileIdentity(
          uid,
          data
        ) &&

        data.get(
          'name',
          ''
        ) is string &&

        data.get(
          'displayName',
          ''
        ) is string &&

        data.get(
          'username',
          ''
        ) is string &&

        data.get(
          'photo',
          ''
        ) is string &&

        data.get(
          'photoURL',
          ''
        ) is string &&

        data.get(
          'mobileNumber',
          ''
        ) == '' &&

        data.get(
          'mobileAdded',
          false
        ) == false &&

        data.get(
          'mobileLocked',
          false
        ) == false &&

        data.get(
          'deviceId',
          ''
        ) == '' &&

        data.get(
          'deviceAdded',
          false
        ) == false &&

        data.get(
          'deviceLocked',
          false
        ) == false &&

        isValidReferralCode(
          data.get(
            'referralCode',
            ''
          )
        ) &&

        data.get(
          'referralLink',
          ''
        ) ==
          'https://11play.github.io/11play/?ref=' +
          data.get(
            'referralCode',
            ''
          ) &&

        data.get(
          'status',
          ''
        ) == 'active' &&

        data.get(
          'statusChangedAt',
          null
        ) == null &&

        data.get(
          'statusChangedBy',
          ''
        ) == '' &&

        isRequestTime(
          data.get(
            'registrationDate',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'lastLogin',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'updatedAt',
            null
          )
        ) &&

        data.get(
          'schemaVersion',
          0
        ) == 3 &&

        validProfileReferralBindingOnCreate(
          uid,
          data
        ) &&

        validProfileBootstrapCompanions(
          uid,
          data
        );
    }

    /* =====================================================
       MOBILE / DEVICE TRANSITIONS
    ===================================================== */

    function validMobileReservationAfter(
      uid,
      mobile
    ) {
      let reservation =
        getAfter(
          mobilePath(
            mobile
          )
        );

      return reservation != null &&

        reservation.data.get(
          'mobile',
          ''
        ) == mobile &&

        reservation.data.get(
          'uid',
          ''
        ) == uid &&

        reservation.data.get(
          'userId',
          ''
        ) == uid;
    }

    function validDeviceReservationAfter(
      uid,
      deviceId
    ) {
      let reservation =
        getAfter(
          devicePath(
            deviceId
          )
        );

      return reservation != null &&

        reservation.data.get(
          'deviceId',
          ''
        ) == deviceId &&

        reservation.data.get(
          'uid',
          ''
        ) == uid &&

        reservation.data.get(
          'userId',
          ''
        ) == uid;
    }

    function validMobileTransition(
      uid,
      before,
      after
    ) {
      let oldMobile =
        before.get(
          'mobileNumber',
          ''
        );

      let newMobile =
        after.get(
          'mobileNumber',
          ''
        );

      return (
        oldMobile == '' &&

        newMobile == '' &&

        after.get(
          'mobileAdded',
          false
        ) == false &&

        after.get(
          'mobileLocked',
          false
        ) == false
      ) || (
        oldMobile == '' &&

        isValidBangladeshMobile(
          newMobile
        ) &&

        after.get(
          'mobileAdded',
          false
        ) == true &&

        after.get(
          'mobileLocked',
          false
        ) == true &&

        validMobileReservationAfter(
          uid,
          newMobile
        )
      ) || (
        isValidBangladeshMobile(
          oldMobile
        ) &&

        newMobile ==
          oldMobile &&

        after.get(
          'mobileAdded',
          false
        ) == true &&

        after.get(
          'mobileLocked',
          false
        ) == true &&

        validMobileReservationAfter(
          uid,
          newMobile
        )
      );
    }

    function validDeviceTransition(
      uid,
      before,
      after
    ) {
      let oldDevice =
        before.get(
          'deviceId',
          ''
        );

      let newDevice =
        after.get(
          'deviceId',
          ''
        );

      return (
        oldDevice == '' &&

        newDevice == '' &&

        after.get(
          'deviceAdded',
          false
        ) == false &&

        after.get(
          'deviceLocked',
          false
        ) == false
      ) || (
        oldDevice == '' &&

        isValidDeviceId(
          newDevice
        ) &&

        after.get(
          'deviceAdded',
          false
        ) == true &&

        after.get(
          'deviceLocked',
          false
        ) == true &&

        validDeviceReservationAfter(
          uid,
          newDevice
        )
      ) || (
        isValidDeviceId(
          oldDevice
        ) &&

        newDevice ==
          oldDevice &&

        after.get(
          'deviceAdded',
          false
        ) == true &&

        after.get(
          'deviceLocked',
          false
        ) == true &&

        validDeviceReservationAfter(
          uid,
          newDevice
        )
      );
    }

    function validOwnerProfileUpdate(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      return isOwner(uid) &&

        before.get(
          'status',
          'active'
        ) == 'active' &&

        before.get(
          'schemaVersion',
          0
        ) == 3 &&

        validProfileKeysV3(
          after
        ) &&

        validProfileIdentity(
          uid,
          after
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'name',
          'displayName',
          'photo',
          'photoURL',
          'providerIds',

          'mobileNumber',
          'mobileAdded',
          'mobileLocked',

          'deviceId',
          'deviceAdded',
          'deviceLocked',

          'lastLogin',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'username',
          ''
        ) ==
          before.get(
            'username',
            ''
          ) &&

        after.get(
          'referralCode',
          ''
        ) ==
          before.get(
            'referralCode',
            ''
          ) &&

        after.get(
          'referralLink',
          ''
        ) ==
          before.get(
            'referralLink',
            ''
          ) &&

        after.get(
          'referredByUid',
          ''
        ) ==
          before.get(
            'referredByUid',
            ''
          ) &&

        after.get(
          'referredByCode',
          ''
        ) ==
          before.get(
            'referredByCode',
            ''
          ) &&

        after.get(
          'registrationDate',
          null
        ) ==
          before.get(
            'registrationDate',
            null
          ) &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        after.get(
          'status',
          ''
        ) ==
          before.get(
            'status',
            ''
          ) &&

        after.get(
          'statusChangedAt',
          null
        ) ==
          before.get(
            'statusChangedAt',
            null
          ) &&

        after.get(
          'statusChangedBy',
          ''
        ) ==
          before.get(
            'statusChangedBy',
            ''
          ) &&

        (
          after.get(
            'lastLogin',
            null
          ) ==
            before.get(
              'lastLogin',
              null
            ) ||

          isRequestTime(
            after.get(
              'lastLogin',
              null
            )
          )
        ) &&

        validMobileTransition(
          uid,
          before,
          after
        ) &&

        validDeviceTransition(
          uid,
          before,
          after
        ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    /* =====================================================
       LEGACY PROFILE V2 -> V3 MIGRATION
    ===================================================== */

    function validOwnerProfileMigration(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      let oldMobile =
        before.get(
          'mobileNumber',
          ''
        );

      let codeAfter =
        getAfter(
          referralCodePath(
            after.get(
              'referralCode',
              ''
            )
          )
        );

      return isOwner(uid) &&

        before.get(
          'schemaVersion',
          0
        ) == 2 &&

        validProfileKeysV3(
          after
        ) &&

        validProfileIdentity(
          uid,
          after
        ) &&

        after.get(
          'name',
          ''
        ) is string &&

        after.get(
          'displayName',
          ''
        ) is string &&

        after.get(
          'username',
          ''
        ) ==
          before.get(
            'username',
            ''
          ) &&

        after.get(
          'photo',
          ''
        ) is string &&

        after.get(
          'photoURL',
          ''
        ) is string &&

        isValidReferralCode(
          after.get(
            'referralCode',
            ''
          )
        ) &&

        after.get(
          'referralCode',
          ''
        ) ==
          before.get(
            'referralCode',
            ''
          ) &&

        after.get(
          'referralLink',
          ''
        ) ==
          'https://11play.github.io/11play/?ref=' +
          after.get(
            'referralCode',
            ''
          ) &&

        after.get(
          'referredByUid',
          ''
        ) ==
          before.get(
            'referredByUid',
            ''
          ) &&

        after.get(
          'referredByCode',
          ''
        ) ==
          before.get(
            'referredByCode',
            ''
          ) &&

        after.get(
          'registrationDate',
          null
        ) ==
          before.get(
            'registrationDate',
            null
          ) &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        isValidProfileStatus(
          after.get(
            'status',
            'active'
          )
        ) &&

        after.get(
          'status',
          'active'
        ) ==
          before.get(
            'status',
            'active'
          ) &&

        after.get(
          'statusChangedAt',
          null
        ) ==
          before.get(
            'statusChangedAt',
            null
          ) &&

        after.get(
          'statusChangedBy',
          ''
        ) ==
          before.get(
            'statusChangedBy',
            ''
          ) &&

        (
          (
            isValidBangladeshMobile(
              oldMobile
            ) &&

            after.get(
              'mobileNumber',
              ''
            ) ==
              oldMobile &&

            after.get(
              'mobileAdded',
              false
            ) == true &&

            after.get(
              'mobileLocked',
              false
            ) == true &&

            validMobileReservationAfter(
              uid,
              oldMobile
            )
          ) || (
            !isValidBangladeshMobile(
              oldMobile
            ) &&

            after.get(
              'mobileNumber',
              ''
            ) == '' &&

            after.get(
              'mobileAdded',
              false
            ) == false &&

            after.get(
              'mobileLocked',
              false
            ) == false
          )
        ) &&

        after.get(
          'deviceId',
          ''
        ) == '' &&

        after.get(
          'deviceAdded',
          false
        ) == false &&

        after.get(
          'deviceLocked',
          false
        ) == false &&

        isRequestTime(
          after.get(
            'lastLogin',
            null
          )
        ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3 &&

        codeAfter != null &&

        codeAfter.data.get(
          'uid',
          ''
        ) == uid &&

        codeAfter.data.get(
          'referralCode',
          ''
        ) ==
          after.get(
            'referralCode',
            ''
          ) &&

        validProfileReferralBindingAfterMigration(
          uid,
          after
        );
    }

    function validAdminProfileStatusUpdate(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      return isAdmin() &&

        before.get(
          'schemaVersion',
          0
        ) == 3 &&

        validProfileKeysV3(
          after
        ) &&

        isValidProfileStatus(
          after.get(
            'status',
            ''
          )
        ) &&

        after.get(
          'status',
          ''
        ) !=
          before.get(
            'status',
            'active'
          ) &&

        (
          uid != request.auth.uid ||
          after.get(
            'status',
            ''
          ) == 'active'
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'status',
          'statusChangedAt',
          'statusChangedBy',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'statusChangedBy',
          ''
        ) ==
