        ) == uid &&

        after.get(
          'userId',
          ''
        ) == uid &&

        after.get(
          'availableBalance',
          0
        ) ==
          before.get(
            'availableBalance',
            0
          ) &&

        after.get(
          'heldBalance',
          0
        ) ==
          before.get(
            'heldBalance',
            0
          ) &&

        after.get(
          'totalEarned',
          0
        ) ==
          before.get(
            'totalEarned',
            0
          ) &&

        after.get(
          'totalWithdrawn',
          0
        ) ==
          before.get(
            'totalWithdrawn',
            0
          ) &&

        after.get(
          'lastWithdrawalAmount',
          0
        ) ==
          before.get(
            'lastWithdrawalAmount',
            0
          ) &&

        after.get(
          'lastWithdrawalAt',
          null
        ) ==
          before.get(
            'lastWithdrawalAt',
            null
          ) &&

        after.get(
          'revision',
          0
        ) ==
          before.get(
            'revision',
            0
          ) &&

        after.get(
          'lastOperationId',
          ''
        ) ==
          before.get(
            'lastOperationId',
            ''
          ) &&

        after.get(
          'lastOperationType',
          ''
        ) ==
          before.get(
            'lastOperationType',
            ''
          ) &&

        after.get(
          'lastOperationAt',
          null
        ) ==
          before.get(
            'lastOperationAt',
            null
          ) &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    /* =====================================================
       WALLET LEDGER
    ===================================================== */

    function validLedgerKeys(
      data
    ) {
      return data.keys().hasOnly([
        'transactionId',
        'userId',
        'uid',

        'type',
        'direction',
        'amount',

        'referenceId',
        'operationId',

        'availableBalanceBefore',
        'availableBalanceAfter',

        'heldBalanceBefore',
        'heldBalanceAfter',

        'totalEarnedBefore',
        'totalEarnedAfter',

        'totalWithdrawnBefore',
        'totalWithdrawnAfter',

        'adminUid',
        'adminEmail',

        'note',
        'status',
        'metadata',

        'createdAt',
        'updatedAt',
        'schemaVersion'
      ]);
    }

    function validUserLedgerBase(
      transactionId,
      data
    ) {
      return isVerifiedGoogle() &&

        validLedgerKeys(
          data
        ) &&

        data.get(
          'transactionId',
          ''
        ) ==
          transactionId &&

        data.get(
          'userId',
          ''
        ) ==
          request.auth.uid &&

        data.get(
          'uid',
          ''
        ) ==
          request.auth.uid &&

        data.get(
          'amount',
          0
        ) is int &&

        data.get(
          'amount',
          0
        ) > 0 &&

        data.get(
          'adminUid',
          ''
        ) == '' &&

        data.get(
          'adminEmail',
          ''
        ) == '' &&

        data.get(
          'status',
          ''
        ) ==
          'completed' &&

        data.get(
          'metadata',
          {}
        ) is map &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'updatedAt',
            null
          )
        ) &&

        data.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function validUserHoldLedger(
      transactionId,
      data
    ) {
      let withdrawalId =
        data.get(
          'referenceId',
          ''
        );

      let withdrawalAfter =
        getAfter(
          withdrawalPath(
            withdrawalId
          )
        );

      let walletAfter =
        getAfter(
          walletPath(
            request.auth.uid
          )
        );

      return data.get(
          'type',
          ''
        ) ==
          'withdraw_hold' &&

        data.get(
          'direction',
          ''
        ) ==
          'debit' &&

        isValidWithdrawalAmount(
          data.get(
            'amount',
            0
          )
        ) &&

        transactionId ==
          'withdraw_hold_' +
          withdrawalId &&

        withdrawalAfter != null &&

        data.get(
          'operationId',
          ''
        ) ==
          withdrawalAfter.data.get(
            'requestId',
            ''
          ) &&

        withdrawalAfter.data.get(
          'userId',
          ''
        ) ==
          request.auth.uid &&

        withdrawalAfter.data.get(
          'status',
          ''
        ) ==
          'pending' &&

        withdrawalAfter.data.get(
          'amount',
          0
        ) ==
          data.get(
            'amount',
            0
          ) &&

        data.get(
          'availableBalanceAfter',
          -1
        ) ==
          data.get(
            'availableBalanceBefore',
            0
          ) -
          data.get(
            'amount',
            0
          ) &&

        data.get(
          'heldBalanceAfter',
          -1
        ) ==
          data.get(
            'heldBalanceBefore',
            0
          ) +
          data.get(
            'amount',
            0
          ) &&

        data.get(
          'totalEarnedAfter',
          -1
        ) ==
          data.get(
            'totalEarnedBefore',
            0
          ) &&

        data.get(
          'totalWithdrawnAfter',
          -1
        ) ==
          data.get(
            'totalWithdrawnBefore',
            0
          ) &&

        walletAfter != null &&

        walletAfter.data.get(
          'availableBalance',
          -1
        ) ==
          data.get(
            'availableBalanceAfter',
            -1
          ) &&

        walletAfter.data.get(
          'heldBalance',
          -1
        ) ==
          data.get(
            'heldBalanceAfter',
            -1
          );
    }

    function validUserLedgerCreate(
      transactionId
    ) {
      let data =
        request.resource.data;

      return validUserLedgerBase(
          transactionId,
          data
        ) &&

        validUserHoldLedger(
          transactionId,
          data
        );
    }

    /* =====================================================
       WITHDRAWAL
    ===================================================== */

    function validWithdrawalKeysV3(
      data
    ) {
      return data.keys().hasOnly([
        'withdrawalId',
        'userId',
        'uid',

        'provider',
        'walletNumber',
        'wallet',
        'number',

        'amount',
        'status',

        'requestId',
        'transactionId',
        'holdTransactionId',
        'completionTransactionId',
        'refundTransactionId',

        'paymentConfirmed',
        'paymentConfirmedAt',
        'paymentReference',

        'reviewedAt',
        'approvedAt',
        'rejectedAt',
        'cancelledAt',

        'reviewedBy',
        'adminNote',

        'date',
        'createdAt',
        'updatedAt',

        'schemaVersion'
      ]);
    }

    function validWithdrawalCreate(
      withdrawalId
    ) {
      let data =
        request.resource.data;

      let profile =
        get(
          profilePath(
            request.auth.uid
          )
        );

      let walletBefore =
        get(
          walletPath(
            request.auth.uid
          )
        );

      let walletAfter =
        getAfter(
          walletPath(
            request.auth.uid
          )
        );

      let holdAfter =
        getAfter(
          walletTransactionPath(
            data.get(
              'holdTransactionId',
              ''
            )
          )
        );

      return isVerifiedGoogle() &&

        validWithdrawalKeysV3(
          data
        ) &&

        data.get(
          'withdrawalId',
          ''
        ) ==
          withdrawalId &&

        data.get(
          'userId',
          ''
        ) ==
          request.auth.uid &&

        data.get(
          'uid',
          ''
        ) ==
          request.auth.uid &&

        profile != null &&

        profile.data.get(
          'status',
          'active'
        ) == 'active' &&

        isValidProvider(
          data.get(
            'provider',
            ''
          )
        ) &&

        isValidBangladeshMobile(
          data.get(
            'walletNumber',
            ''
          )
        ) &&

        data.get(
          'wallet',
          ''
        ) ==
          data.get(
            'walletNumber',
            ''
          ) &&

        data.get(
          'number',
          ''
        ) ==
          data.get(
            'walletNumber',
            ''
          ) &&

        isValidWithdrawalAmount(
          data.get(
            'amount',
            0
          )
        ) &&

        data.get(
          'status',
          ''
        ) ==
          'pending' &&

        data.get(
          'requestId',
          ''
        ) is string &&

        data.get(
          'requestId',
          ''
        ) != '' &&

        data.get(
          'transactionId',
          ''
        ) ==
          data.get(
            'holdTransactionId',
            ''
          ) &&

        data.get(
          'holdTransactionId',
          ''
        ) ==
          'withdraw_hold_' +
          withdrawalId &&

        data.get(
          'completionTransactionId',
          ''
        ) == '' &&

        data.get(
          'refundTransactionId',
          ''
        ) == '' &&

        data.get(
          'paymentConfirmed',
          false
        ) == false &&

        data.get(
          'paymentConfirmedAt',
          null
        ) == null &&

        data.get(
          'paymentReference',
          ''
        ) == '' &&

        data.get(
          'reviewedAt',
          null
        ) == null &&

        data.get(
          'approvedAt',
          null
        ) == null &&

        data.get(
          'rejectedAt',
          null
        ) == null &&

        data.get(
          'cancelledAt',
          null
        ) == null &&

        data.get(
          'reviewedBy',
          ''
        ) == '' &&

        data.get(
          'adminNote',
          ''
        ) == '' &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        data.get(
          'date',
          null
        ) ==
          data.get(
            'createdAt',
            null
          ) &&

        data.get(
          'updatedAt',
          null
        ) ==
          data.get(
            'createdAt',
            null
          ) &&

        data.get(
          'schemaVersion',
          0
        ) == 3 &&

        walletBefore != null &&

        walletAfter != null &&

        walletBefore.data.get(
          'availableBalance',
          0
        ) >=
          data.get(
            'amount',
            0
          ) &&

        walletAfter.data.get(
          'lastOperationType',
          ''
        ) ==
          'withdraw_hold' &&

        walletAfter.data.get(
          'lastOperationId',
          ''
        ) ==
          data.get(
            'holdTransactionId',
            ''
          ) &&

        holdAfter != null &&

        holdAfter.data.get(
          'transactionId',
          ''
        ) ==
          data.get(
            'holdTransactionId',
            ''
          ) &&

        holdAfter.data.get(
          'amount',
          0
        ) ==
          data.get(
            'amount',
            0
          );
    }

    /* =====================================================
       ADMIN REFERRAL
    ===================================================== */

    function referralIsEligibleForAdmin(
      before
    ) {
      let referredUid =
        before.get(
          'referredUid',
          ''
        );

      let referredProfile =
        get(
          profilePath(
            referredUid
          )
        );

      let activity =
        get(
          activityPath(
            referredUid
          )
        );

      let mobile =
        referredProfile == null
          ? ''
          : referredProfile.data.get(
              'mobileNumber',
              ''
            );

      let deviceId =
        referredProfile == null
          ? ''
          : referredProfile.data.get(
              'deviceId',
              ''
            );

      return before.get(
          'status',
          ''
        ) in [
          'qualified',
          'approved'
        ] &&

        before.get(
          'eligible',
          false
        ) == true &&

        before.get(
          'googleConnected',
          false
        ) == true &&

        before.get(
          'mobileAdded',
          false
        ) == true &&

        before.get(
          'deviceAdded',
          false
        ) == true &&

        before.get(
          'requiredActiveDays',
          0
        ) == 7 &&

        before.get(
          'requiredDailySeconds',
          0
        ) == 7200 &&

        before.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        before.get(
          'activityCompleted',
          false
        ) == true &&

        before.get(
          'rewardGranted',
          false
        ) == false &&

        referredProfile != null &&

        referredProfile.data.get(
          'status',
          'active'
        ) ==
          'active' &&

        referredProfile.data.get(
          'googleConnected',
          false
        ) == true &&

        referredProfile.data.get(
          'isGoogleConnected',
          false
        ) == true &&

        mobileReservationBelongsTo(
          referredUid,
          mobile
        ) &&

        deviceReservationBelongsTo(
          referredUid,
          deviceId
        ) &&

        activity != null &&

        activity.data.get(
          'schemaVersion',
          0
        ) == 3 &&

        activity.data.get(
          'activityPolicyVersion',
          0
        ) == 2 &&

        activity.data.get(
          'requiredDailySeconds',
          0
        ) == 7200 &&

        activity.data.get(
          'completed',
          false
        ) == true &&

        activity.data.get(
          'activeDays',
          0
        ) == 7;
    }

    function validAdminReferralApproval(
      referralId,
      before,
      after
    ) {
      let referrerUid =
        before.get(
          'referrerUid',
          ''
        );

      let walletAfter =
        getAfter(
          walletPath(
            referrerUid
          )
        );

      let statsBefore =
        get(
          statsPath(
            referrerUid
          )
        );

      let statsAfter =
        getAfter(
          statsPath(
            referrerUid
          )
        );

      let ledgerAfter =
        getAfter(
          walletTransactionPath(
            'referral_reward_' +
            referralId
          )
        );

      return referralIsEligibleForAdmin(
          before
        ) &&

        validReferralKeysV3(
          after
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'status',
          'rewardGranted',
          'rewardGrantedAt',
          'reviewedAt',
          'reviewedBy',
          'approvedAt',
          'rewardedAt',
          'adminNote',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'status',
          ''
        ) ==
          'rewarded' &&

        after.get(
          'rewardGranted',
          false
        ) == true &&

        isRequestTime(
          after.get(
            'rewardGrantedAt',
            null
          )
        ) &&

        isRequestTime(
          after.get(
            'reviewedAt',
            null
          )
        ) &&

        after.get(
          'reviewedBy',
          ''
        ) ==
          request.auth.uid &&

        isRequestTime(
          after.get(
            'approvedAt',
            null
          )
        ) &&

        isRequestTime(
          after.get(
            'rewardedAt',
            null
          )
        ) &&

        after.get(
          'adminNote',
          ''
        ) is string &&

        after.get(
          'adminNote',
          ''
        ).size() <= 500 &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3 &&

        walletAfter != null &&

        walletAfter.data.get(
          'lastOperationType',
          ''
        ) ==
          'referral_reward' &&

        walletAfter.data.get(
          'lastOperationId',
          ''
        ) ==
          'referral_reward_' +
          referralId &&

        statsBefore != null &&

        statsAfter != null &&

        statsAfter.data.get(
          'total',
          -1
        ) ==
          statsBefore.data.get(
            'total',
            0
          ) &&

        statsAfter.data.get(
          'pending',
          -1
        ) ==
          statsBefore.data.get(
            'pending',
            0
          ) &&

        statsAfter.data.get(
          'qualified',
          -1
        ) ==
          (
            before.get(
              'status',
              ''
            ) == 'qualified'

              ? (
                  statsBefore.data.get(
                    'qualified',
                    0
                  ) > 0

                    ? statsBefore.data.get(
                        'qualified',
                        0
                      ) - 1

                    : 0
                )

              : statsBefore.data.get(
                  'qualified',
                  0
                )
          ) &&

        statsAfter.data.get(
          'approved',
          -1
        ) ==
          statsBefore.data.get(
            'approved',
            0
          ) +
          (
            before.get(
              'status',
              ''
            ) == 'qualified'

              ? 1
              : 0
          ) &&

        statsAfter.data.get(
          'rejected',
          -1
        ) ==
          statsBefore.data.get(
            'rejected',
            0
          ) &&

        statsAfter.data.get(
          'rewarded',
          -1
        ) ==
          statsBefore.data.get(
            'rewarded',
            0
          ) + 1 &&

        statsAfter.data.get(
          'totalReward',
          -1
        ) ==
          statsBefore.data.get(
            'totalReward',
            0
          ) + 1000 &&

        ledgerAfter != null &&

        ledgerAfter.data.get(
          'transactionId',
          ''
        ) ==
          'referral_reward_' +
          referralId;
    }

    function validAdminReferralReject(
      referralId,
      before,
      after
    ) {
      let statsBefore =
        get(
          statsPath(
            before.get(
              'referrerUid',
              ''
            )
          )
        );

      let statsAfter =
        getAfter(
          statsPath(
            before.get(
              'referrerUid',
              ''
            )
          )
        );

      let auditAfter =
        getAfter(
          auditPath(
            'referral_rejected_' +
            referralId
          )
        );

      return before.get(
          'status',
          ''
        ) == 'qualified' &&

        before.get(
          'rewardGranted',
          false
        ) == false &&

        validReferralKeysV3(
          after
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'status',
          'reviewedAt',
          'reviewedBy',
          'rejectedAt',
          'adminNote',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'status',
          ''
        ) == 'rejected' &&

        after.get(
          'rewardGranted',
          false
        ) == false &&

        isRequestTime(
          after.get(
            'reviewedAt',
            null
          )
        ) &&

        after.get(
          'reviewedBy',
          ''
        ) ==
          request.auth.uid &&

        isRequestTime(
          after.get(
            'rejectedAt',
            null
          )
        ) &&

        after.get(
          'approvedAt',
          null
        ) == null &&

        after.get(
          'rewardedAt',
          null
        ) == null &&

        after.get(
          'adminNote',
          ''
        ) is string &&

        after.get(
          'adminNote',
          ''
        ).size() <= 500 &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3 &&

        statsBefore != null &&

        statsAfter != null &&

        statsAfter.data.get(
          'total',
          -1
        ) ==
          statsBefore.data.get(
            'total',
            0
          ) &&

        statsAfter.data.get(
          'pending',
          -1
        ) ==
          statsBefore.data.get(
            'pending',
            0
          ) &&

        statsAfter.data.get(
          'qualified',
          -1
        ) ==
          (
            statsBefore.data.get(
              'qualified',
              0
            ) > 0

              ? statsBefore.data.get(
                  'qualified',
                  0
                ) - 1

              : 0
          ) &&

        statsAfter.data.get(
          'approved',
          -1
        ) ==
          statsBefore.data.get(
            'approved',
            0
          ) &&

        statsAfter.data.get(
          'rejected',
          -1
        ) ==
          statsBefore.data.get(
            'rejected',
            0
          ) + 1 &&

        statsAfter.data.get(
          'rewarded',
          -1
        ) ==
          statsBefore.data.get(
            'rewarded',
            0
          ) &&

        statsAfter.data.get(
          'totalReward',
          -1
        ) ==
          statsBefore.data.get(
            'totalReward',
            0
          ) &&

        auditAfter != null &&

        auditAfter.data.get(
          'auditId',
          ''
        ) ==
          'referral_rejected_' +
          referralId;
    }

    function validAdminReferralUpdate(
      referralId
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      return isAdmin() &&

        before.get(
          'referralId',
          referralId
        ) ==
          referralId &&

        after.get(
          'referralId',
          referralId
        ) ==
          referralId &&

        (
          (
            after.get(
              'status',
              ''
            ) ==
              'rewarded' &&

            validAdminReferralApproval(
              referralId,
              before,
              after
            )
          ) || (
            after.get(
              'status',
              ''
            ) ==
              'rejected' &&

            validAdminReferralReject(
              referralId,
              before,
              after
            )
          )
        );
    }

    /* =====================================================
       ADMIN STATS
    ===================================================== */

    function validAdminStatsTransition(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      let rewardedDelta =
        after.get(
          'rewarded',
          0
        ) -
        before.get(
          'rewarded',
          0
        );

      let rejectedDelta =
        after.get(
          'rejected',
          0
        ) -
        before.get(
          'rejected',
          0
        );

      let approvedDelta =
        after.get(
          'approved',
          0
        ) -
        before.get(
          'approved',
          0
        );

      let qualifiedDelta =
        after.get(
          'qualified',
          0
        ) -
        before.get(
          'qualified',
          0
        );

      return isAdmin() &&

        validStatsKeys(
          after
        ) &&

        after.get(
          'uid',
          ''
        ) ==
          uid &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'qualified',
          'approved',
          'rejected',
          'rewarded',
          'totalReward',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'total',
          0
        ) ==
          before.get(
            'total',
            0
          ) &&

        after.get(
          'pending',
          0
        ) ==
          before.get(
            'pending',
            0
          ) &&

        (
          (
            rewardedDelta == 1 &&

            rejectedDelta == 0 &&

            approvedDelta == 1 &&

            qualifiedDelta == -1 &&

            after.get(
              'totalReward',
              0
            ) ==
              before.get(
                'totalReward',
                0
              ) + 1000
          ) || (
            rewardedDelta == 1 &&

            rejectedDelta == 0 &&

            approvedDelta == 0 &&

            qualifiedDelta == 0 &&

            after.get(
              'totalReward',
              0
            ) ==
              before.get(
                'totalReward',
                0
              ) + 1000
          ) || (
            rewardedDelta == 0 &&

            rejectedDelta == 1 &&

            approvedDelta == 0 &&

            qualifiedDelta == -1 &&

            after.get(
              'totalReward',
              0
            ) ==
              before.get(
                'totalReward',
                0
              )
          )
        ) &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    /* =====================================================
       ADMIN WALLET
    ===================================================== */

    function validAdminWalletCreate(
      uid,
      data
    ) {
      let transactionId =
        data.get(
          'lastOperationId',
          ''
        );

      let ledgerAfter =
        transactionId == ''
          ? null
          : getAfter(
              walletTransactionPath(
                transactionId
              )
            );

      let rewardCreate =
        data.get(
          'lastOperationType',
          ''
        ) ==
          'referral_reward' &&

        data.get(
          'availableBalance',
          -1
        ) == 1000 &&

        data.get(
          'heldBalance',
          -1
        ) == 0 &&

        data.get(
          'totalEarned',
          -1
        ) == 1000 &&

        data.get(
          'totalWithdrawn',
          -1
        ) == 0;

      let adjustmentCreate =
        data.get(
          'lastOperationType',
          ''
        ) ==
          'admin_adjustment' &&

        data.get(
          'availableBalance',
          -1
        ) > 0 &&

        data.get(
          'heldBalance',
          -1
        ) == 0 &&

        data.get(
          'totalEarned',
          -1
        ) == 0 &&

        data.get(
          'totalWithdrawn',
          -1
        ) == 0;

      return isAdmin() &&

        validWalletKeysV3(
          data
        ) &&

        data.get(
          'uid',
          ''
        ) == uid &&

        data.get(
          'userId',
          ''
        ) == uid &&

        data.get(
          'availableBalance',
          -1
        ) is int &&

        data.get(
          'heldBalance',
          -1
        ) is int &&

        data.get(
          'totalEarned',
          -1
        ) is int &&

        data.get(
          'totalWithdrawn',
          -1
        ) is int &&

        data.get(
          'lastWithdrawalAmount',
          -1
        ) == 0 &&

        data.get(
          'lastWithdrawalAt',
          null
        ) == null &&

        data.get(
          'revision',
          -1
        ) == 1 &&

        transactionId != '' &&

        ledgerAfter != null &&

        ledgerAfter.data.get(
          'transactionId',
          ''
        ) ==
          transactionId &&

        ledgerAfter.data.get(
          'userId',
          ''
        ) ==
          uid &&

        ledgerAfter.data.get(
          'type',
          ''
        ) ==
          data.get(
            'lastOperationType',
            ''
          ) &&

        (
          rewardCreate ||
          adjustmentCreate
        ) &&

        isRequestTime(
          data.get(
            'lastOperationAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'updatedAt',
            null
          )
        ) &&

        data.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function validAdminWalletReward(
      before,
      after
    ) {
      let transactionId =
        after.get(
          'lastOperationId',
          ''
        );

      let ledgerAfter =
        getAfter(
          walletTransactionPath(
            transactionId
          )
        );

      let referralId =
        ledgerAfter == null
          ? ''
          : ledgerAfter.data.get(
              'referenceId',
              ''
            );

      let referralAfter =
        referralId == ''
          ? null
          : getAfter(
              referralPath(
                referralId
              )
            );

      return after.get(
          'lastOperationType',
          ''
        ) ==
          'referral_reward' &&

        transactionId ==
          'referral_reward_' +
          referralId &&

        referralId != '' &&

        after.get(
          'availableBalance',
          0
        ) ==
          before.get(
            'availableBalance',
            0
          ) + 1000 &&

        after.get(
          'heldBalance',
          0
        ) ==
          before.get(
            'heldBalance',
            0
          ) &&

        after.get(
          'totalEarned',
          0
        ) ==
          before.get(
            'totalEarned',
            0
          ) + 1000 &&

        after.get(
          'totalWithdrawn',
          0
        ) ==
          before.get(
            'totalWithdrawn',
            0
          ) &&

        after.get(
          'lastWithdrawalAmount',
          0
        ) ==
          before.get(
            'lastWithdrawalAmount',
            0
          ) &&

        after.get(
          'lastWithdrawalAt',
          null
        ) ==
          before.get(
            'lastWithdrawalAt',
            null
          ) &&

        ledgerAfter != null &&

        ledgerAfter.data.get(
          'type',
          ''
        ) ==
          'referral_reward' &&

        ledgerAfter.data.get(
          'amount',
          0
        ) == 1000 &&

        referralAfter != null &&

        referralAfter.data.get(
          'status',
          ''
        ) ==
          'rewarded';
    }

    function validAdminWalletWithdrawalSuccess(
      before,
      after
    ) {
      let transactionId =
        after.get(
          'lastOperationId',
          ''
        );

      let ledgerAfter =
        getAfter(
          walletTransactionPath(
            transactionId
          )
        );

      let withdrawalId =
        ledgerAfter == null
          ? ''
          : ledgerAfter.data.get(
              'referenceId',
              ''
            );

      let withdrawalAfter =
        withdrawalId == ''
          ? null
          : getAfter(
              withdrawalPath(
                withdrawalId
              )
            );

      let amount =
        before.get(
          'heldBalance',
          0
        ) -
        after.get(
          'heldBalance',
          0
        );

      return after.get(
          'lastOperationType',
          ''
        ) ==
          'withdraw_success' &&

        transactionId ==
          'withdraw_success_' +
          withdrawalId &&

        withdrawalId != '' &&

        isValidWithdrawalAmount(
          amount
        ) &&

        after.get(
          'availableBalance',
          0
        ) ==
          before.get(
            'availableBalance',
            0
          ) &&

        after.get(
          'totalEarned',
          0
        ) ==
          before.get(
            'totalEarned',
            0
          ) &&

        after.get(
          'totalWithdrawn',
          0
        ) ==
          before.get(
            'totalWithdrawn',
            0
          ) +
          amount &&

        after.get(
          'lastWithdrawalAmount',
          0
        ) ==
          amount &&

        isRequestTime(
          after.get(
            'lastWithdrawalAt',
            null
          )
        ) &&

        ledgerAfter != null &&

        ledgerAfter.data.get(
          'type',
          ''
        ) ==
          'withdraw_success' &&

        ledgerAfter.data.get(
          'amount',
          0
        ) ==
          amount &&

        withdrawalAfter != null &&

        withdrawalAfter.data.get(
          'status',
          ''
        ) ==
          'approved' &&

        withdrawalAfter.data.get(
          'amount',
          0
        ) ==
          amount;
    }

    function validAdminWalletWithdrawalReject(
      before,
      after
    ) {
      let transactionId =
        after.get(
          'lastOperationId',
          ''
        );

      let ledgerAfter =
        getAfter(
          walletTransactionPath(
            transactionId
          )
        );

      let withdrawalId =
        ledgerAfter == null
          ? ''
          : ledgerAfter.data.get(
              'referenceId',
              ''
            );

      let withdrawalAfter =
        withdrawalId == ''
          ? null
          : getAfter(
              withdrawalPath(
                withdrawalId
              )
            );

      let amount =
        after.get(
          'availableBalance',
          0
        ) -
        before.get(
          'availableBalance',
          0
        );

      return after.get(
          'lastOperationType',
          ''
        ) ==
          'withdraw_refund' &&

        transactionId ==
          'withdraw_refund_' +
          withdrawalId &&

        withdrawalId != '' &&

        isValidWithdrawalAmount(
          amount
        ) &&

        after.get(
          'heldBalance',
          0
        ) ==
          before.get(
            'heldBalance',
            0
          ) -
          amount &&

        after.get(
          'totalEarned',
          0
        ) ==
          before.get(
            'totalEarned',
            0
          ) &&

        after.get(
          'totalWithdrawn',
          0
        ) ==
          before.get(
            'totalWithdrawn',
            0
          ) &&

        after.get(
          'lastWithdrawalAmount',
          0
        ) ==
          before.get(
            'lastWithdrawalAmount',
            0
          ) &&

        after.get(
          'lastWithdrawalAt',
          null
        ) ==
          before.get(
            'lastWithdrawalAt',
            null
          ) &&

        ledgerAfter != null &&

        ledgerAfter.data.get(
          'type',
          ''
        ) ==
          'withdraw_refund' &&

        ledgerAfter.data.get(
          'amount',
          0
        ) ==
          amount &&

        withdrawalAfter != null &&

        withdrawalAfter.data.get(
          'status',
          ''
        ) ==
          'rejected' &&

        withdrawalAfter.data.get(
          'amount',
          0
        ) ==
          amount;
    }

    function validAdminWalletAdjustment(
      before,
      after
    ) {
      let transactionId =
        after.get(
          'lastOperationId',
          ''
        );

      let ledgerAfter =
        getAfter(
          walletTransactionPath(
            transactionId
          )
        );

      let delta =
        after.get(
          'availableBalance',
          0
        ) -
        before.get(
          'availableBalance',
          0
        );

      return after.get(
          'lastOperationType',
          ''
        ) ==
          'admin_adjustment' &&

        transactionId != '' &&

        delta != 0 &&

        after.get(
          'availableBalance',
          -1
        ) >= 0 &&

        after.get(
          'heldBalance',
          0
        ) ==
          before.get(
            'heldBalance',
            0
          ) &&

        after.get(
          'totalEarned',
          0
        ) ==
          before.get(
            'totalEarned',
            0
          ) &&

        after.get(
          'totalWithdrawn',
          0
        ) ==
          before.get(
            'totalWithdrawn',
            0
          ) &&

        after.get(
          'lastWithdrawalAmount',
          0
        ) ==
          before.get(
            'lastWithdrawalAmount',
            0
          ) &&

        after.get(
          'lastWithdrawalAt',
          null
        ) ==
          before.get(
            'lastWithdrawalAt',
            null
          ) &&

        ledgerAfter != null &&

        ledgerAfter.data.get(
          'type',
          ''
        ) ==
          'admin_adjustment' &&

        ledgerAfter.data.get(
          'direction',
          ''
        ) ==
          (
            delta > 0
              ? 'credit'
              : 'debit'
          ) &&

        ledgerAfter.data.get(
          'amount',
          0
        ) ==
          (
            delta > 0
              ? delta
              : -delta
          );
    }

    function validAdminWalletUpdate(
      uid
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      return isAdmin() &&

        validWalletKeysV3(
          after
        ) &&

        after.get(
          'uid',
          ''
        ) ==
          uid &&

        after.get(
          'userId',
          ''
        ) ==
          uid &&

        after.get(
          'availableBalance',
          -1
        ) is int &&

        after.get(
          'availableBalance',
          -1
        ) >= 0 &&

        after.get(
          'heldBalance',
          -1
        ) is int &&

        after.get(
          'heldBalance',
          -1
        ) >= 0 &&

        after.get(
          'totalEarned',
          -1
        ) is int &&

        after.get(
          'totalEarned',
          -1
        ) >= 0 &&

        after.get(
          'totalWithdrawn',
          -1
        ) is int &&

        after.get(
          'totalWithdrawn',
          -1
        ) >= 0 &&

        after.get(
          'revision',
          -1
        ) ==
          before.get(
            'revision',
            0
          ) + 1 &&

        isRequestTime(
          after.get(
            'lastOperationAt',
            null
          )
        ) &&

        after.get(
          'createdAt',
          null
        ) ==
          before.get(
            'createdAt',
            null
          ) &&

        (
          validAdminWalletReward(
            before,
            after
          ) ||

          validAdminWalletWithdrawalSuccess(
            before,
            after
          ) ||

          validAdminWalletWithdrawalReject(
            before,
            after
          ) ||

          validAdminWalletAdjustment(
            before,
            after
          )
        ) &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3;
    }

    /* =====================================================
       ADMIN WITHDRAWAL
    ===================================================== */

    function validAdminWithdrawalUpdate(
      withdrawalId
    ) {
      let before =
        resource.data;

      let after =
        request.resource.data;

      let uid =
        before.get(
          'userId',
          before.get(
            'uid',
            ''
          )
        );

      let approved =
        after.get(
          'status',
          ''
        ) ==
          'approved';

      let walletAfter =
        getAfter(
          walletPath(
            uid
          )
        );

      let ledgerId =
        approved
          ? 'withdraw_success_' +
            withdrawalId
          : 'withdraw_refund_' +
            withdrawalId;

      let ledgerAfter =
        getAfter(
          walletTransactionPath(
            ledgerId
          )
        );

      let auditAfter =
        getAfter(
          auditPath(
            approved
              ? 'withdrawal_approved_' +
                withdrawalId
              : 'withdrawal_rejected_' +
                withdrawalId
          )
        );

      return isAdmin() &&

        before.get(
          'status',
          ''
        ) ==
          'pending' &&

        validWithdrawalKeysV3(
          after
        ) &&

        after.get(
          'status',
          ''
        ) in [
          'approved',
          'rejected'
        ] &&

        isValidWithdrawalAmount(
          before.get(
            'amount',
            0
          )
        ) &&

        after.diff(
          before
        ).affectedKeys().hasOnly([
          'status',
          'completionTransactionId',
          'refundTransactionId',
          'reviewedAt',
          'approvedAt',
          'rejectedAt',
          'reviewedBy',
          'adminNote',
          'updatedAt',
          'schemaVersion'
        ]) &&

        after.get(
          'paymentConfirmed',
          false
        ) ==
          before.get(
            'paymentConfirmed',
            false
          ) &&

        after.get(
          'paymentConfirmedAt',
          null
        ) ==
          before.get(
            'paymentConfirmedAt',
            null
          ) &&

        after.get(
          'paymentReference',
          ''
        ) ==
          before.get(
            'paymentReference',
            ''
          ) &&

        after.get(
          'cancelledAt',
          null
        ) ==
          before.get(
            'cancelledAt',
            null
          ) &&

        after.get(
          'reviewedBy',
          ''
        ) ==
          request.auth.uid &&

        isRequestTime(
          after.get(
            'reviewedAt',
            null
          )
        ) &&

        after.get(
          'adminNote',
          ''
        ) is string &&

        after.get(
          'adminNote',
          ''
        ).size() <= 500 &&

        isRequestTime(
          after.get(
            'updatedAt',
            null
          )
        ) &&

        after.get(
          'schemaVersion',
          0
        ) == 3 &&

        walletAfter != null &&

        ledgerAfter != null &&

        ledgerAfter.data.get(
          'transactionId',
          ''
        ) ==
          ledgerId &&

        auditAfter != null &&

        (
          (
            approved &&

            after.get(
              'completionTransactionId',
              ''
            ) ==
              ledgerId &&

            after.get(
              'refundTransactionId',
              ''
            ) == '' &&

            isRequestTime(
              after.get(
                'approvedAt',
                null
              )
            ) &&

            after.get(
              'rejectedAt',
              null
            ) == null &&

            walletAfter.data.get(
              'lastOperationType',
              ''
            ) ==
              'withdraw_success' &&

            walletAfter.data.get(
              'lastOperationId',
              ''
            ) ==
              ledgerId &&

            auditAfter.data.get(
              'auditId',
              ''
            ) ==
              'withdrawal_approved_' +
              withdrawalId
          ) || (
            !approved &&

            after.get(
              'completionTransactionId',
              ''
            ) == '' &&

            after.get(
              'refundTransactionId',
              ''
            ) ==
              ledgerId &&

            after.get(
              'approvedAt',
              null
            ) == null &&

            isRequestTime(
              after.get(
                'rejectedAt',
                null
              )
            ) &&

            walletAfter.data.get(
              'lastOperationType',
              ''
            ) ==
              'withdraw_refund' &&

            walletAfter.data.get(
              'lastOperationId',
              ''
            ) ==
              ledgerId &&

            auditAfter.data.get(
              'auditId',
              ''
            ) ==
              'withdrawal_rejected_' +
              withdrawalId
          )
        );
    }

    /* =====================================================
       ADMIN LEDGER
    ===================================================== */

    function validAdminLedgerBase(
      transactionId,
      data
    ) {
      return isAdmin() &&

        validLedgerKeys(
          data
        ) &&

        data.get(
          'transactionId',
          ''
        ) ==
          transactionId &&

        data.get(
          'userId',
          ''
        ) is string &&

        data.get(
          'userId',
          ''
        ) != '' &&

        data.get(
          'uid',
          ''
        ) ==
          data.get(
            'userId',
            ''
          ) &&

        data.get(
          'amount',
          0
        ) is int &&

        data.get(
          'amount',
          0
        ) > 0 &&

        data.get(
          'adminUid',
          ''
        ) ==
          request.auth.uid &&

        data.get(
          'adminEmail',
          ''
        ).lower() ==
          currentEmail() &&

        data.get(
          'status',
          ''
        ) ==
          'completed' &&

        data.get(
          'metadata',
          {}
        ) is map &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'updatedAt',
            null
          )
        ) &&

        data.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function validAdminReferralLedger(
      transactionId,
      data
    ) {
      let referralId =
        data.get(
          'referenceId',
          ''
        );

      let referralAfter =
        getAfter(
          referralPath(
            referralId
          )
        );

      let walletAfter =
        getAfter(
          walletPath(
            data.get(
              'userId',
              ''
            )
          )
        );

      return data.get(
          'type',
          ''
        ) ==
          'referral_reward' &&

        data.get(
          'direction',
          ''
        ) ==
          'credit' &&

        data.get(
          'amount',
          0
        ) ==
          1000 &&

        transactionId ==
          'referral_reward_' +
          referralId &&

        data.get(
          'operationId',
          ''
        ) ==
          'referral_' +
          referralId &&

        referralAfter != null &&

        referralAfter.data.get(
          'status',
          ''
        ) ==
          'rewarded' &&

        referralAfter.data.get(
          'referrerUid',
          ''
        ) ==
          data.get(
            'userId',
            ''
          ) &&

        data.get(
          'availableBalanceAfter',
          -1
        ) ==
          data.get(
            'availableBalanceBefore',
            0
          ) + 1000 &&

        data.get(
          'heldBalanceAfter',
          -1
        ) ==
          data.get(
            'heldBalanceBefore',
            0
          ) &&

        data.get(
          'totalEarnedAfter',
          -1
        ) ==
          data.get(
            'totalEarnedBefore',
            0
          ) + 1000 &&

        data.get(
          'totalWithdrawnAfter',
          -1
        ) ==
          data.get(
            'totalWithdrawnBefore',
            0
          ) &&

        walletAfter != null &&

        walletAfter.data.get(
          'availableBalance',
          -1
        ) ==
          data.get(
            'availableBalanceAfter',
            -1
          ) &&

        walletAfter.data.get(
          'totalEarned',
          -1
        ) ==
          data.get(
            'totalEarnedAfter',
            -1
          );
    }

    function validAdminWithdrawalLedger(
      transactionId,
      data
    ) {
      let withdrawalId =
        data.get(
          'referenceId',
          ''
        );

      let withdrawalAfter =
        getAfter(
          withdrawalPath(
            withdrawalId
          )
        );

      let walletAfter =
        getAfter(
          walletPath(
            data.get(
              'userId',
              ''
            )
          )
        );

      let approval =
        data.get(
          'type',
          ''
        ) ==
          'withdraw_success';

      return withdrawalAfter != null &&

        withdrawalAfter.data.get(
          'userId',
          ''
        ) ==
          data.get(
            'userId',
            ''
          ) &&

        data.get(
          'amount',
          0
        ) ==
          withdrawalAfter.data.get(
            'amount',
            0
          ) &&

        isValidWithdrawalAmount(
          data.get(
            'amount',
            0
          )
        ) &&

        (
          (
            approval &&

            transactionId ==
              'withdraw_success_' +
              withdrawalId &&

            data.get(
              'direction',
              ''
            ) ==
              'debit' &&

            withdrawalAfter.data.get(
              'status',
              ''
            ) ==
              'approved' &&

            data.get(
              'operationId',
              ''
            ) ==
              'withdrawal_approved_' +
              withdrawalId &&

            data.get(
              'availableBalanceAfter',
              -1
            ) ==
              data.get(
                'availableBalanceBefore',
                0
              ) &&

            data.get(
              'heldBalanceAfter',
              -1
            ) ==
              data.get(
                'heldBalanceBefore',
                0
              ) -
              data.get(
                'amount',
                0
              ) &&

            data.get(
              'totalWithdrawnAfter',
              -1
            ) ==
              data.get(
                'totalWithdrawnBefore',
                0
              ) +
              data.get(
                'amount',
                0
              )
          ) || (
            !approval &&

            data.get(
              'type',
              ''
            ) ==
              'withdraw_refund' &&

            transactionId ==
              'withdraw_refund_' +
              withdrawalId &&

            data.get(
              'direction',
              ''
            ) ==
              'credit' &&

            withdrawalAfter.data.get(
              'status',
              ''
            ) ==
              'rejected' &&

            data.get(
              'operationId',
              ''
            ) ==
              'withdrawal_rejected_' +
              withdrawalId &&

            data.get(
              'availableBalanceAfter',
              -1
            ) ==
              data.get(
                'availableBalanceBefore',
                0
              ) +
              data.get(
                'amount',
                0
              ) &&

            data.get(
              'heldBalanceAfter',
              -1
            ) ==
              data.get(
                'heldBalanceBefore',
                0
              ) -
              data.get(
                'amount',
                0
              ) &&

            data.get(
              'totalWithdrawnAfter',
              -1
            ) ==
              data.get(
                'totalWithdrawnBefore',
                0
              )
          )
        ) &&

        data.get(
          'totalEarnedAfter',
          -1
        ) ==
          data.get(
            'totalEarnedBefore',
            0
          ) &&

        walletAfter != null &&

        walletAfter.data.get(
          'availableBalance',
          -1
        ) ==
          data.get(
            'availableBalanceAfter',
            -1
          ) &&

        walletAfter.data.get(
          'heldBalance',
          -1
        ) ==
          data.get(
            'heldBalanceAfter',
            -1
          );
    }

    function validAdminAdjustmentLedger(
      transactionId,
      data
    ) {
      let walletAfter =
        getAfter(
          walletPath(
            data.get(
              'userId',
              ''
            )
          )
        );

      let delta =
        data.get(
          'direction',
          ''
        ) == 'credit'

          ? data.get(
              'amount',
              0
            )

          : -data.get(
              'amount',
              0
            );

      return data.get(
          'type',
          ''
        ) ==
          'admin_adjustment' &&

        data.get(
          'direction',
          ''
        ) in [
          'credit',
          'debit'
        ] &&

        data.get(
          'referenceId',
          ''
        ) ==
          data.get(
            'operationId',
            ''
          ) &&

        data.get(
          'operationId',
          ''
        ) != '' &&

        data.get(
          'availableBalanceAfter',
          -1
        ) ==
          data.get(
            'availableBalanceBefore',
            0
          ) +
          delta &&

        data.get(
          'availableBalanceAfter',
          -1
        ) >= 0 &&

        data.get(
          'heldBalanceAfter',
          -1
        ) ==
          data.get(
            'heldBalanceBefore',
            0
          ) &&

        data.get(
          'totalEarnedAfter',
          -1
        ) ==
          data.get(
            'totalEarnedBefore',
            0
          ) &&

        data.get(
          'totalWithdrawnAfter',
          -1
        ) ==
          data.get(
            'totalWithdrawnBefore',
            0
          ) &&

        walletAfter != null &&

        walletAfter.data.get(
          'availableBalance',
          -1
        ) ==
          data.get(
            'availableBalanceAfter',
            -1
          ) &&

        walletAfter.data.get(
          'lastOperationType',
          ''
        ) ==
          'admin_adjustment' &&

        walletAfter.data.get(
          'lastOperationId',
          ''
        ) ==
          transactionId;
    }

    function validAdminLedgerCreate(
      transactionId
    ) {
      let data =
        request.resource.data;

      return validAdminLedgerBase(
          transactionId,
          data
        ) &&

        (
          validAdminReferralLedger(
            transactionId,
            data
          ) ||

          validAdminWithdrawalLedger(
            transactionId,
            data
          ) ||

          validAdminAdjustmentLedger(
            transactionId,
            data
          )
        );
    }

    /* =====================================================
       REWARD EVENT
    ===================================================== */

    function validRewardEventCreate(
      rewardEventId
    ) {
      let data =
        request.resource.data;

      let referralId =
        data.get(
          'referralId',
          ''
        );

      let referralAfter =
        getAfter(
          referralPath(
            referralId
          )
        );

      let ledgerAfter =
        getAfter(
          walletTransactionPath(
            data.get(
              'walletTransactionId',
              ''
            )
          )
        );

      return isAdmin() &&

        data.keys().hasOnly([
          'rewardEventId',
          'type',
          'status',

          'userId',
          'uid',
          'referredUid',

          'referralId',
          'referralCode',

          'amount',

          'walletTransactionId',

          'approvedBy',
          'approvedByEmail',
          'approvedAt',

          'creditedAt',

          'createdAt',
          'updatedAt',

          'schemaVersion'
        ]) &&

        rewardEventId ==
          'referral_' +
          referralId &&

        data.get(
          'rewardEventId',
          ''
        ) ==
          rewardEventId &&

        data.get(
          'type',
          ''
        ) ==
          'referral' &&

        data.get(
          'status',
          ''
        ) ==
          'credited' &&

        data.get(
          'userId',
          ''
        ) ==
          data.get(
            'uid',
            ''
          ) &&

        data.get(
          'referredUid',
          ''
        ) ==
          referralId &&

        isValidReferralCode(
          data.get(
            'referralCode',
            ''
          )
        ) &&

        data.get(
          'amount',
          0
        ) ==
          1000 &&

        data.get(
          'walletTransactionId',
          ''
        ) ==
          'referral_reward_' +
          referralId &&

        data.get(
          'approvedBy',
          ''
        ) ==
          request.auth.uid &&

        data.get(
          'approvedByEmail',
          ''
        ).lower() ==
          currentEmail() &&

        isRequestTime(
          data.get(
            'approvedAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'creditedAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'updatedAt',
            null
          )
        ) &&

        data.get(
          'schemaVersion',
          0
        ) ==
          3 &&

        referralAfter != null &&

        referralAfter.data.get(
          'status',
          ''
        ) ==
          'rewarded' &&

        referralAfter.data.get(
          'rewardGranted',
          false
        ) ==
          true &&

        referralAfter.data.get(
          'referrerUid',
          ''
        ) ==
          data.get(
            'userId',
            ''
          ) &&

        ledgerAfter != null &&

        ledgerAfter.data.get(
          'type',
          ''
        ) ==
          'referral_reward' &&

        ledgerAfter.data.get(
          'amount',
          0
        ) ==
          1000;
    }

    /* =====================================================
       ADMIN AUDIT
    ===================================================== */

    function validAuditBase(
      auditId,
      data
    ) {
      return isAdmin() &&

        data.get(
          'auditId',
          ''
        ) ==
          auditId &&

        data.get(
          'adminUid',
          ''
        ) ==
          request.auth.uid &&

        data.get(
          'adminEmail',
          ''
        ).lower() ==
          currentEmail() &&

        data.get(
          'adminRole',
          ''
        ) ==
          'admin' &&

        data.get(
          'note',
          ''
        ) is string &&

        data.get(
          'note',
          ''
        ).size() <= 500 &&

        isRequestTime(
          data.get(
            'createdAt',
            null
          )
        ) &&

        isRequestTime(
          data.get(
            'updatedAt',
            null
          )
        ) &&

        data.get(
          'schemaVersion',
          0
        ) == 3;
    }

    function validReferralAudit(
      auditId,
      data
    ) {
      let referralId =
        data.get(
          'referralId',
          ''
        );

      let referralAfter =
        getAfter(
          referralPath(
            referralId
          )
        );

      let approval =
        data.get(
          'action',
          ''
        ) ==
          'referral_approved';

      return referralAfter != null &&

        data.get(
          'targetUid',
          ''
        ) ==
          referralAfter.data.get(
            'referredUid',
            referralId
          ) &&

        data.get(
          'referrerUid',
          ''
        ) ==
          referralAfter.data.get(
            'referrerUid',
            ''
          ) &&

        (
          (
            approval &&

            auditId ==
              'referral_approved_' +
              referralId &&

            data.get(
              'newStatus',
              ''
            ) ==
              'rewarded' &&

            referralAfter.data.get(
              'status',
              ''
            ) ==
              'rewarded' &&

            data.get(
              'rewardAmount',
              0
            ) ==
              1000 &&

            data.get(
              'walletTransactionId',
              ''
            ) ==
              'referral_reward_' +
              referralId
          ) || (
            !approval &&

            data.get(
              'action',
              ''
            ) ==
              'referral_rejected' &&

            auditId ==
              'referral_rejected_' +
              referralId &&

            data.get(
              'newStatus',
              ''
            ) ==
              'rejected' &&

            referralAfter.data.get(
              'status',
              ''
            ) ==
              'rejected'
          )
        );
    }

    function validWithdrawalAudit(
      auditId,
      data
    ) {
      let withdrawalId =
        data.get(
          'withdrawalId',
          ''
        );

      let withdrawalAfter =
        getAfter(
          withdrawalPath(
            withdrawalId
          )
        );

      let approval =
        data.get(
          'action',
          ''
        ) ==
          'withdrawal_approved';

      return withdrawalAfter != null &&

        data.get(
          'targetUid',
          ''
        ) ==
          withdrawalAfter.data.get(
            'userId',
            withdrawalAfter.data.get(
              'uid',
              ''
            )
          ) &&

        data.get(
          'amount',
          0
        ) ==
          withdrawalAfter.data.get(
            'amount',
            0
          ) &&

        (
          (
            approval &&

            auditId ==
              'withdrawal_approved_' +
              withdrawalId &&

            data.get(
              'newStatus',
              ''
            ) ==
              'approved' &&

            withdrawalAfter.data.get(
              'status',
              ''
            ) ==
              'approved' &&

            data.get(
              'walletTransactionId',
              ''
            ) ==
              'withdraw_success_' +
              withdrawalId
          ) || (
            !approval &&

            data.get(
              'action',
              ''
            ) ==
              'withdrawal_rejected' &&

            auditId ==
              'withdrawal_rejected_' +
              withdrawalId &&

            data.get(
              'newStatus',
              ''
            ) ==
              'rejected' &&

            withdrawalAfter.data.get(
              'status',
              ''
            ) ==
              'rejected' &&

            data.get(
              'walletTransactionId',
              ''
            ) ==
              'withdraw_refund_' +
              withdrawalId
          )
        );
    }

    function validProfileStatusAudit(
      data
    ) {
      let uid =
        data.get(
          'targetUid',
          ''
        );

      let profileAfter =
        getAfter(
          profilePath(
            uid
          )
        );

      return data.get(
          'action',
          ''
        ) ==
          'profile_status_changed' &&

        profileAfter != null &&

        data.get(
          'newStatus',
          ''
        ) ==
          profileAfter.data.get(
            'status',
            'active'
          ) &&

        isValidProfileStatus(
          data.get(
            'newStatus',
            ''
          )
        ) &&

        profileAfter.data.get(
          'statusChangedBy',
          ''
        ) ==
          request.auth.uid;
    }

    function validWalletAdjustmentAudit(
      data
    ) {
      let walletAfter =
        getAfter(
          walletPath(
            data.get(
              'targetUid',
              ''
            )
          )
        );

      let ledgerAfter =
        getAfter(
          walletTransactionPath(
            data.get(
              'walletTransactionId',
              ''
            )
          )
        );

      return data.get(
          'action',
          ''
        ) ==
          'wallet_adjusted' &&

        data.get(
          'direction',
          ''
        ) in [
          'credit',
          'debit'
        ] &&

        data.get(
          'amount',
          0
        ) is int &&

        data.get(
          'amount',
          0
        ) > 0 &&

        data.get(
          'operationId',
          ''
        ) is string &&

        data.get(
          'operationId',
          ''
        ) != '' &&

        walletAfter != null &&

        ledgerAfter != null &&

        ledgerAfter.data.get(
          'type',
          ''
        ) ==
          'admin_adjustment' &&

        ledgerAfter.data.get(
          'operationId',
          ''
        ) ==
          data.get(
            'operationId',
            ''
          ) &&

        walletAfter.data.get(
          'lastOperationId',
          ''
        ) ==
          data.get(
            'walletTransactionId',
            ''
          );
    }

    function validAuditCreate(
      auditId
    ) {
      let data =
        request.resource.data;

      return validAuditBase(
          auditId,
          data
        ) &&

        (
          (
            data.get(
              'action',
              ''
            ) in [
              'referral_approved',
              'referral_rejected'
            ] &&

            validReferralAudit(
              auditId,
              data
            )
          ) || (
            data.get(
              'action',
              ''
            ) in [
              'withdrawal_approved',
              'withdrawal_rejected'
            ] &&

            validWithdrawalAudit(
              auditId,
              data
            )
          ) || (
            data.get(
              'action',
              ''
            ) ==
              'profile_status_changed' &&

            validProfileStatusAudit(
              data
            )
          ) || (
            data.get(
              'action',
              ''
            ) ==
              'wallet_adjusted' &&

            validWalletAdjustmentAudit(
              data
            )
          )
        );
    }

    /* =====================================================
       PUBLIC APPLICATION DATA
    ===================================================== */

    match /sites/{siteId} {
      allow read: if true;
      allow write: if false;
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    /* =====================================================
       SITE CLICKS
       Manual Global Popular Ranking
    ===================================================== */

    match /siteClicks/{siteId} {
      allow read: if true;
      allow write: if false;
    }

    /* =====================================================
       PROFILE USERS
    ===================================================== */

    match /profileUsers/{uid} {
      allow get: if
        isOwner(uid) ||
        isAdmin();

      allow list: if
        isAdmin();

      allow create: if
        validOwnerProfileCreate(
          uid
        );

      allow update: if
        validOwnerProfileUpdate(
          uid
        ) ||

        validOwnerProfileMigration(
          uid
        ) ||

        validAdminProfileStatusUpdate(
          uid
        );

      allow delete: if false;
    }

    /* =====================================================
       UNIQUE REFERRAL CODE
    ===================================================== */

    match /profileReferralCodes/{referralCode} {
      allow get: if
        isVerifiedGoogle();

      allow list: if
        isAdmin();

      allow create: if
        validReferralCodeCreate(
          referralCode
        );

      allow update, delete: if false;
    }

    /* =====================================================
       UNIQUE MOBILE
    ===================================================== */

    match /profileMobiles/{mobile} {
      allow get: if
        isAdmin() || (
          isVerifiedGoogle() &&

          resource.data.get(
            'uid',
            ''
          ) ==
            request.auth.uid
        );

      allow list: if
        isAdmin();

      allow create: if
        validMobileReservationCreate(
          mobile
        );

      allow update, delete: if false;
    }

    /* =====================================================
       UNIQUE WEB DEVICE
    ===================================================== */

    match /profileDevices/{deviceId} {
      allow get: if
        isAdmin() || (
          isVerifiedGoogle() &&

          resource.data.get(
            'uid',
            ''
          ) ==
            request.auth.uid
        );

      allow list: if
        isAdmin();

      allow create: if
        validDeviceReservationCreate(
          deviceId
        );

      allow update, delete: if false;
    }

    /* =====================================================
       REFERRALS
    ===================================================== */

    match /profileReferrals/{referralId} {
      allow get: if
        isAdmin() ||
        isReferralParticipant(
          resource.data
        );

      allow list: if
        isAdmin() ||
        isReferralParticipant(
          resource.data
        );

      allow create: if
        validReferralCreate(
          referralId
        );

      allow update: if
        validAdminReferralUpdate(
          referralId
        ) ||

        validReferralUpdateByReferredUser(
          referralId
        ) ||

        validReferralPolicyResetByReferredUser(
          referralId
        ) ||

        validReferralMigrationByReferredUser(
          referralId
        );

      allow delete: if false;
    }

    /* =====================================================
       REFERRAL STATS
    ===================================================== */

    match /profileReferralStats/{uid} {
      allow get: if
        isOwner(uid) ||
        isAdmin();

      allow list: if
        isAdmin();

      allow create: if
        isOwner(uid) &&
        validInitialStats(
          uid,
          request.resource.data
        );

      allow update: if
        validRelatedStatsUpdate(
          uid
        ) ||

        validAdminStatsTransition(
          uid
        ) ||

        validStatsMigration(
          uid
        );

      allow delete: if false;
    }

    /* =====================================================
       ACTIVITY
    ===================================================== */

    match /profileActivity/{uid} {
      allow get: if
        isOwner(uid) ||
        isAdmin();

      allow list: if
        isAdmin();

      allow create: if
        isOwner(uid) &&
        validInitialActivity(
          uid,
          request.resource.data
        );

      allow update: if
        validOwnerActivityStart(
          uid
        ) ||

        validOwnerActivityResume(
          uid
        ) ||

        validOwnerActivityCheckpoint(
          uid
        ) ||

        validActivityMigration(
          uid
        );

      allow delete: if false;
    }

    /* =====================================================
       LEGACY ACTIVITY SESSION HISTORY
    ===================================================== */

    match /profileActivitySessions/{sessionDocumentId} {
      allow get: if
        isAdmin() ||
        belongsToCurrentUser(
          resource.data
        );

      allow list: if
        isAdmin() ||
        belongsToCurrentUser(
          resource.data
        );

      allow write: if false;
    }

    /* =====================================================
       WALLET
    ===================================================== */

    match /profileWallets/{uid} {
      allow get: if
        isOwner(uid) ||
        isAdmin();

      allow list: if
        isAdmin();

      allow create: if
        (
          isOwner(uid) &&
          validInitialWallet(
            uid,
            request.resource.data
          )
        ) ||

        validAdminWalletCreate(
          uid,
          request.resource.data
        );

      allow update: if
        validOwnerWalletUpdate(
          uid
        ) ||

        validAdminWalletUpdate(
          uid
        ) ||

        validWalletMigration(
          uid
        );

      allow delete: if false;
    }

    /* =====================================================
       WALLET LEDGER
    ===================================================== */

    match /profileWalletTransactions/{transactionId} {
      allow get: if
        isAdmin() ||
        belongsToCurrentUser(
          resource.data
        );

      allow list: if
        isAdmin() ||
        belongsToCurrentUser(
          resource.data
        );

      allow create: if
        validUserLedgerCreate(
          transactionId
        ) ||

        validAdminLedgerCreate(
          transactionId
        );

      allow update, delete: if false;
    }

    /* =====================================================
       REWARD EVENTS
    ===================================================== */

    match /profileRewardEvents/{rewardEventId} {
      allow get, list: if
        isAdmin();

      allow create: if
        validRewardEventCreate(
          rewardEventId
        );

      allow update, delete: if false;
    }

    /* =====================================================
       WITHDRAWALS
       User cannot update/cancel after create.
    ===================================================== */

    match /profileWithdrawals/{withdrawalId} {
      allow get: if
        isAdmin() ||
        belongsToCurrentUser(
          resource.data
        );

      allow list: if
        isAdmin() ||
        belongsToCurrentUser(
          resource.data
        );

      allow create: if
        validWithdrawalCreate(
          withdrawalId
        );

      allow update: if
        validAdminWithdrawalUpdate(
          withdrawalId
        );

      allow delete: if false;
    }

    /* =====================================================
       DEPRECATED ADMIN DOCUMENTS
    ===================================================== */

    match /profileAdmins/{uid} {
      allow read, write: if false;
    }

    /* =====================================================
       ADMIN AUDIT
    ===================================================== */

    match /profileAuditLogs/{auditId} {
      allow get, list: if
        isAdmin();

      allow create: if
        validAuditCreate(
          auditId
        );

      allow update, delete: if false;
    }

    /* =====================================================
       SETTINGS
    ===================================================== */

    match /profileSettings/publicAdminReferral {
      allow read, write: if false;
    }

    match /profileSettings/{settingId} {
      allow get, list: if
        isAdmin();

      allow create, update: if
        isAdmin();

      allow delete: if false;
    }

    /* =====================================================
       DEFAULT DENY
    ===================================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}