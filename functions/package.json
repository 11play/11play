{
  "name": "11play-profile-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions backend for the 11Play Profile, Referral, Activity, Wallet, Withdrawal and Admin systems.",
  "private": true,
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  }
}